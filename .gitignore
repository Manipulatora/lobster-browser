# Dependencies
node_modules/
.pnp.*
.yarn/

# Build output
dist/
dist-win/
dist-windows/
dist-linux/
build/
out/
*.tsbuildinfo
# Rust
target/
apps/desktop/src-tauri/target/
# Tauri-generated schemas/capabilities
apps/desktop/src-tauri/gen/
apps/desktop/dist/
# Packaged Node + sidecar (regenerated by scripts/bundle-sidecar.mjs / build-linux-product.sh)
apps/desktop/src-tauri/resources/
# Built Lobee extension (regenerated from packages/lobee-app by scripts/build-lobee.mjs, which
# rm -rf's and rewrites this dir). Loaded into profiles from the build output, never edited by hand.
packages/lobee/
# Validation screenshots/reports (local GPU runs)
ci/validation/reports/
# QA working output: generated persona configs (each stages its own font pack, so this gets large),
# diagnostic JSON, mascot screenshots, engine build logs. Local evidence, same status as reports/
# above - the docs/qa write-ups cite these paths, but the bytes are reproducible from the scripts
# and are not source. Also keeps host-specific checkout paths in scratch notes out of the
# source-hygiene scan, which reads tracked files.
qa-out/

# Engines (downloaded on first run, never committed)
engines/bin/
engines/cache/
*.dmg
*.exe
*.AppImage

# Claude Code local settings
.claude/settings.local.json

# Environment / secrets
.env
# Also catches the timestamped `.env.bak.<epoch>` copies an edit-in-place leaves behind: a backup
# duplicates JWT_SECRET and DATABASE_URL into a second file that nobody remembers to delete.
.env.*
!.env.example
*.pem
*.key
secrets/

# Local runtime data (desktop stores profiles under the OS app-data dir / .lobster).
# NOTE: do NOT add a bare `profiles/` here — it would ignore source dirs like
# apps/backend/src/profiles and apps/desktop/src/features/profiles.
.lobster/
/profiles/
*.sqlite
*.sqlite-*
*.db

# Logs
*.log
logs/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/
.nyc_output/
test-results/
playwright-report/

# Scratch / intermediate generation output (image-gen frames, contact sheets, experiments)
tmp/

# Python (tooling / scripts)
__pycache__/
*.pyc
.venv/
venv/
ci/validation/reports/*.png

# A GitHub token handed over for a one-off push. No such file should exist in a clone — this stays
# so that pasting one back in cannot be committed by a `git add .`, not as permission to keep one.
ghtoken*.txt
