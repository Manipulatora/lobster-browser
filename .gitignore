# Dependencies
node_modules/
.pnp.*
.yarn/

# Build output
dist/
build/
out/
*.tsbuildinfo
# Rust
target/
apps/desktop/src-tauri/target/
# Tauri-generated schemas/capabilities
apps/desktop/src-tauri/gen/
apps/desktop/dist/

# Engines (downloaded on first run, never committed)
engines/bin/
engines/cache/
*.dmg
*.exe
*.AppImage

# Claude Code local settings
.claude/settings.local.json

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Local runtime data (desktop stores profiles under the OS app-data dir / .lobster).
# NOTE: do NOT add a bare `profiles/` here — it would ignore source dirs like
# apps/backend/src/profiles and apps/desktop/src/features/profiles.
.lobster/
/profiles/
*.sqlite
*.sqlite-*
*.db

# Logs
*.log
logs/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/
.nyc_output/
test-results/
playwright-report/

# Python (Camoufox fallback sidecar)
__pycache__/
*.pyc
.venv/
venv/
