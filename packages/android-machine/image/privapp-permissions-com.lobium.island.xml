<?xml version="1.0" encoding="utf-8"?>
<!--
  Privileged-permission allowlist for the built-in Lobium Island app. Placed in the golden image at
  /system/etc/permissions/ so com.lobium.island (a /system/priv-app) is granted the signature|privileged
  permissions it needs to create/manage the isolated user and route installs. Without this allowlist a
  priv-app requesting these permissions fails to boot (Android's privapp-permissions enforcement).
-->
<permissions>
    <privapp-permissions package="com.lobium.island">
        <permission name="android.permission.MANAGE_USERS" />
        <permission name="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <permission name="android.permission.MANAGE_PROFILE_AND_DEVICE_OWNERS" />
    </privapp-permissions>
</permissions>
