{
  "name": "@lobster/cookies",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cookie import/export (JSON + Netscape cookies.txt) for Lobster profiles.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "tsc -b && node --test \"dist/**/*.test.js\"",
    "clean": "rm -rf dist *.tsbuildinfo"
  }
}
