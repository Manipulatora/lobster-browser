# Chromium patch files are byte-sensitive: GNU patch tolerates CRLF, but git apply rejects it.
# A unified-diff context marker is one literal space on otherwise blank lines;
# do not report that required syntax as trailing whitespace in nested patches.
*.patch text eol=lf whitespace=-blank-at-eol
/lobium/patches/series text eol=lf

# Shell scripts must be LF, always. A CRLF `#!/usr/bin/env bash` script is not merely untidy — bash
# reads the carriage return as part of the last token on every line, so the file fails `bash -n`
# with "unexpected end of file" and cannot execute at all on Linux. lobium/build.sh and
# lobium/rebase.sh were committed with CRLF and were, in consequence, both dead on this platform;
# every other .sh in the tree was already LF, so nothing here is a convention being overridden.
*.sh text eol=lf

# These tracked files intentionally use CRLF; do not mistake the carriage return for whitespace.
/.github/workflows/ci.yml whitespace=cr-at-eol
/package-lock.json whitespace=cr-at-eol
/apps/web/package-lock.json whitespace=cr-at-eol
/scripts/bundle-sidecar.mjs whitespace=cr-at-eol
/apps/desktop/src-tauri/src/engine_provision.rs whitespace=cr-at-eol
/apps/desktop/src-tauri/src/sidecar.rs whitespace=cr-at-eol
/lobium/src/BUILD.gn whitespace=cr-at-eol
/lobium/src/lobium_fp_config.cc whitespace=cr-at-eol
/lobium/src/lobium_fp_config.h whitespace=cr-at-eol

# Release artifacts are Git LFS, and ONLY under release/.
#
# The engine archive is 277 MB. GitHub hard-rejects any single file over 100 MB on push, so plain
# git cannot carry it at all, and committing it as ordinary blobs would also put a quarter-gigabyte
# into history permanently for every rebuild - history cannot shed that without a rewrite.
#
# This is a TRANSFER mechanism between the two build hosts, not the product's distribution path.
# Users get the engine from lobrowser.com via engine-manifest.json; see that file's note. Keep the
# glob scoped to release/ so a stray .zip elsewhere in the tree is never silently turned into a
# pointer file, and scoped to BINARY extensions so the README and SHA256SUMS beside them stay
# ordinary git objects - a checksum file you cannot read on the web page without an LFS client is
# not much of a checksum file.
release/**/*.zip    filter=lfs diff=lfs merge=lfs -text
release/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
release/**/*.exe    filter=lfs diff=lfs merge=lfs -text
