{
  "name": "@lobster/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Lobster Browser cloud SaaS API (NestJS) — auth, teams, encrypted profile sync, and billing.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && tsc --outDir dist && node --test \"dist/**/*.spec.js\"",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@lobster/shared-types": "*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.20.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.3"
  }
}
