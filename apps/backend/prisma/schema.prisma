// Lobster Browser — cloud data model.
//
// This schema mirrors the domain contracts in `@lobster/shared-types`
// (User, Team, Membership, Profile, ApiKey, Subscription) so the Postgres tables
// never drift from the TypeScript wire types.
//
// IMPORTANT — encrypted profile blobs:
//   A profile's sensitive payload (cookies, storage, the full user-data-dir snapshot)
//   is encrypted CLIENT-SIDE and stored in S3-compatible object storage. Postgres holds
//   ONLY a reference to that blob (`encryptedBlobRef`) plus non-secret metadata and the
//   deterministic `fingerprintSeed`. No plaintext profile payload is ever sent to the server.
//
//   THIS IS NOT ZERO-KNOWLEDGE, and describing it that way would be a lie by omission. The key
//   those blobs are encrypted under is `VaultKey.dataKey`, which this database holds and which is
//   served to any client that can sign in — see that model for why, and for what wrapping it at
//   rest does and does not protect against.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums -----------------------------------------------------------------

// Mirrors shared-types `Role`.
enum Role {
  admin
  member
}

// Mirrors shared-types `PlanTier`.
//
// `free` is the pre-purchase state every team starts in, not a sellable package. The four
// sellable packages are priced and sized in ONE place, `PLAN_CATALOG` in
// `@lobster/shared-types`; nothing here encodes a price or a profile count. See
// `Subscription.profileLimit` for why the purchased limit is still copied onto the row.
enum PlanTier {
  free
  light
  plus
  pro
  max
}

// Mirrors shared-types `Subscription.status`.
//
// `past_due` is the renewal-failed state: the period ended, Credit was short, and the team is
// read-only (existing profiles keep working, new ones are refused) until a deposit lands. It is
// deliberately distinct from `canceled`, which is the user's own decision and does not retry.
enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
}

// Mirrors shared-types `BillingPeriod`. How long one paid period lasts, and therefore which price
// from `PLAN_CATALOG` applies — the monthly one, or twelve months at the yearly discount.
enum BillingPeriod {
  monthly
  yearly
}

// What moved Credit, for the append-only ledger. Every balance change carries exactly one of
// these, so the ledger reads as a history rather than a set of opaque deltas.
enum CreditTxKind {
  deposit    // crypto payment confirmed on-chain and credited
  purchase   // user bought a package
  renewal    // monthly auto-renew charge
  refund     // credit returned (proration, support action)
  adjustment // a correction that is neither a sale nor a payment — an operator fix, or Credit
             // clawed back when a settled deposit was refunded; always carries a reason in `metadata`
  agent_usage // metered Lobee spend, flushed in whole cents from the team's micro-USD accrual;
              // its own kind rather than an `adjustment` because an adjustment means a human
              // decided something, and this is machine-generated many times a day
}

// Lifecycle of an inbound crypto payment.
//
// `confirming` means seen on-chain but below the provider's confirmation threshold: real, not yet
// spendable. Crediting happens exactly once, on the transition into `confirmed`.
enum DepositStatus {
  pending
  confirming
  confirmed
  failed
  expired
}

// --- Models ----------------------------------------------------------------

// Mirrors shared-types `User`. `passwordHash` is backend-only (never leaves the server);
// real hashing (argon2/bcrypt) lands Day 2.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  displayName  String?
  /// Organisation the account belongs to, collected at sign-up. Optional on the column so accounts
  /// created before it existed remain valid; the sign-up form requires it.
  company      String?
  passwordHash String?
  createdAt    DateTime  @default(now())
  /// Null until the address is proven. Nullable-timestamp rather than a boolean so we keep WHEN,
  /// which matters for disputes and for expiring stale unverified accounts.
  emailVerifiedAt DateTime?

  /// Consecutive wrong passwords since the last successful sign-in, and the instant before which
  /// sign-in is refused outright. Kept ON THE ACCOUNT, not in the process: the per-IP limiter in
  /// front of the app has one bucket per instance per address, so spraying one password across many
  /// accounts from many addresses fills no bucket anywhere. The account being guessed is the only
  /// place the pattern exists. See `loginBackoffUntil` for why this backs off rather than locks.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Relations
  ownedTeams        Team[]              @relation("TeamOwner")
  memberships       Membership[]
  desktopAuthGrants DesktopAuthGrant[]
  emailVerifications EmailVerification[]
  vaultKey          VaultKey?

  @@map("users")
}

/// A sign-up that has been started but not yet proven.
///
/// NO USER EXISTS UNTIL THE CODE IS ENTERED. Registration used to create the account, the personal
/// team and a signed token immediately, then email a code as an afterthought — so abandoning the
/// form at the code step left a real, logged-in, unverified account behind. Anyone could also mint
/// accounts against addresses they do not control, and every one of them consumed the unique
/// `users.email` slot for the real owner.
///
/// The credentials now wait here instead. `POST /auth/register` writes this row and returns no
/// token; `POST /auth/verify-email` checks the code and only then creates the User, Team and
/// Membership in one transaction. An abandoned sign-up expires and is swept, leaving nothing.
///
/// `attempts` is load-bearing. A six-digit code is a million possibilities, which is minutes of
/// brute force against an endpoint that must be public — it has no session to authenticate. The
/// row is refused past a small number of wrong guesses and the sign-up has to be restarted.
model PendingRegistration {
  /// Unique: one live sign-up per address. Re-registering the same address overwrites the row and
  /// supersedes the previous code rather than leaving several valid at once.
  email        String   @id
  passwordHash String
  fullName     String
  company      String?
  /// SHA-256 of the six-digit code. The code itself only ever exists in the email.
  codeHash     String
  expiresAt    DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@map("pending_registrations")
}

/// The key this account's profile snapshots are scrambled with.
///
/// One random key per user, generated on first use and handed to any client that can sign in. The
/// snapshots stored on the server are unreadable without it; a per-profile key is derived from it so
/// one profile's key does not open another's.
///
/// THE SERVER HOLDS THIS KEY, deliberately. The alternative — deriving it from the account password
/// so the server never sees it — means a forgotten password destroys every profile permanently, with
/// nothing support can do. That is a worse product than the risk it avoids for an operator who runs
/// their own server. Signing in is therefore all a user needs to get their profiles back, and a
/// password reset costs them nothing.
///
/// SO BE HONEST ABOUT WHAT THAT COSTS. Because the server holds this key and serves it to any
/// session, a stolen token is a profile-data breach and not merely an account takeover, and anyone
/// holding both this table and the blob store can read every snapshot. The column is wrapped under
/// a deployment master key (`VAULT_MASTER_KEY`, see key-wrapping.ts) so a database dump alone is
/// not sufficient — that is defence in depth, not end-to-end encryption, and the difference is not
/// something to blur.
model VaultKey {
  userId String @id

  /// 32 random bytes, never derived from anything the user types, stored wrapped — a version byte,
  /// nonce, tag and ciphertext under the deployment master key. Rows written before wrapping
  /// existed are the bare 32 bytes and are still read; their own length says which they are.
  dataKey Bytes

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vault_keys")
}

/// A single-use email-verification token.
///
/// Stores a SHA-256 of the token, never the token itself: the mailed value is a bearer credential,
/// and a leaked database should not hand over working links. Rows are kept after consumption so a
/// replayed link is distinguishable from an unknown one.
model EmailVerification {
  id         String    @id @default(uuid())
  userId     String
  /// SHA-256 hex of the emailed 6-digit code. NOT unique: six digits collide across users, and a
  /// unique index would make one user's pending code block another's. Lookups are scoped by userId.
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  /// Failed attempts against this code. Capped so a 6-digit secret cannot be brute-forced.
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verifications")
}

// Mirrors shared-types `Team`.
model Team {
  id          String   @id @default(uuid())
  name        String
  ownerUserId String
  createdAt   DateTime @default(now())

  // Relations
  owner        User          @relation("TeamOwner", fields: [ownerUserId], references: [id])
  memberships  Membership[]
  profiles     Profile[]
  apiKeys      ApiKey[]
  subscription Subscription?
  auditLogs    AuditLog[]
  wallet       Wallet?
  deposits     Deposit[]
  agentUsage   AgentUsage[]

  @@index([ownerUserId])
  @@map("teams")
}

// Mirrors shared-types `Membership`. Composite primary key (userId, teamId).
model Membership {
  userId    String
  teamId    String
  role      Role     @default(member)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId])
  @@map("memberships")
}

// Mirrors shared-types `Profile`.
//
// Only metadata + the deterministic seed + a reference to the encrypted blob live here.
// `metadata` is a JSON grab-bag for the non-secret shared-types fields we don't index on
// (engine, os, tags, folder, notes, proxy reference, sharing, fingerprintOverrides).
/// Which device currently has a profile open.
///
/// A profile is one browser identity. Running it from two machines at once means the same account
/// arriving from two IPs, which is itself the signal an anti-detect profile exists to avoid — so this
/// is a hard block, matching Octo ("It is not possible to work with the same profile simultaneously,
/// but you can do so in turns").
///
/// WHY A LEASE AND NOT A BOOLEAN. A machine that crashes never gets to clear a flag, and Octo's own
/// answer — the profile stays claimed until someone manually force-stops it — leaves users stuck. The
/// lease carries an expiry the holder refreshes while it runs, so a crashed machine's claim lapses on
/// its own and the profile becomes launchable again without an operator.
///
/// One row per profile, created on first claim and reused: `profileId` is the primary key, so the
/// database itself prevents two concurrent holders rather than application logic doing it.
model ProfileLease {
  profileId String @id

  /// Random per-claim id. A release or refresh must present it, so a stale client cannot release a
  /// lease that has since been taken by someone else.
  leaseId String

  userId     String
  /// Stable per-install id, so the UI can say WHICH machine holds it.
  deviceId    String
  deviceLabel String

  acquiredAt DateTime @default(now())
  /// The claim is dead after this instant unless refreshed. Readers must compare against it rather
  /// than trusting the row's existence.
  expiresAt  DateTime

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("profile_leases")
}

model Profile {
  id     String @id @default(uuid())
  name   String

  // Deterministic seed → stable coherent fingerprint (see shared-types `FingerprintSeed`).
  fingerprintSeed  String

  // Reference (S3 object key / URI) to the CLIENT-encrypted profile blob. Nullable until
  // the desktop agent performs its first sync push. The plaintext never touches the server.
  encryptedBlobRef String?

  // Non-secret, non-indexed profile fields (engine, os, tags, folder, notes, sharing, …).
  metadata         Json    @default("{}")

  // Team that owns the profile (maps to shared-types `Profile.ownerTeamId`).
  ownerTeamId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft-delete tombstone. Deleting a profile sets this instead of removing the row, because a
  // machine that was offline during the delete has no other way to LEARN the profile is gone — it
  // would see a missing row as "never synced here" and resurrect it. Every read filters on
  // `deletedAt: null`, so a tombstone is invisible to the API and never consumes the plan's
  // profile allowance.
  deletedAt DateTime?

  // Relations
  ownerTeam Team @relation(fields: [ownerTeamId], references: [id], onDelete: Cascade)
  lease     ProfileLease?

  @@index([ownerTeamId])
  // Every profile read is (ownerTeamId, live), including the plan-limit count.
  @@index([ownerTeamId, deletedAt])
  @@map("profiles")
}

// Mirrors shared-types `ApiKey`. Only the prefix is persisted for display; the secret
// is shown once at creation and stored as a hash (real hashing lands Day 2).
model ApiKey {
  id         String    @id @default(uuid())
  // Human-visible prefix, e.g. "lb_live_ab12" — safe to display in the UI.
  prefix     String
  // Hash of the full secret. The plaintext secret is returned exactly once, at creation.
  hashedKey  String
  name       String
  teamId     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  // Every automation request authenticates by looking a key up on this column, so without the index
  // each one — including every invalid `lb_live_` bearer sprayed at the API — scans the whole table.
  @@index([hashedKey])
  @@map("api_keys")
}

// Mirrors shared-types `AuditLog`. An append-only, immutable action/audit log: rows are only
// ever inserted and read (never updated or deleted in the ordinary flow) so a team keeps a
// durable history of what happened. `metadata` is a non-secret JSON grab-bag for event context.
// The `(teamId, createdAt)` index backs the newest-first, cursor-paginated team feed.
model AuditLog {
  id          String   @id @default(uuid())
  teamId      String
  // The user who performed the action; null for system-originated events.
  actorUserId String?
  // Machine-readable action name, e.g. "profile.created".
  action      String
  // The kind of thing the action targeted, e.g. "profile".
  targetType  String
  // Id of the specific target, when the action concerns one.
  targetId    String?
  // Free-form, non-secret context for the event.
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@map("audit_logs")
}

// Mirrors shared-types `Subscription`. One per team.
//
// Billing is Credit-only: a purchase or renewal debits `Wallet.balanceCents`. There is no card on
// file and no external billing customer, so there is no `stripeCustomerId` here — the previous
// Stripe-shaped fields were removed rather than left dormant.
model Subscription {
  teamId       String             @id
  tier         PlanTier           @default(free)
  // Metered limit — number of profiles allowed on this plan (see ProfilesService).
  //
  // Copied from PLAN_CATALOG at purchase time rather than derived from `tier` on read. A team that
  // bought Pro at 200 profiles keeps 200 even if Pro is later re-sized, and support can grant a
  // one-off higher limit without inventing a tier.
  //
  // The default must equal `FREE_PLAN_PROFILE_LIMIT` in @lobster/shared-types, so a team behaves
  // identically before and after a Subscription row exists.
  profileLimit Int                @default(3)
  status       SubscriptionStatus @default(trialing)

  // What the next renewal will cost, in USD cents. Also snapshotted at purchase, for the same
  // reason as `profileLimit`: a price change must not silently re-price existing subscribers.
  priceCents   Int                @default(0)

  // Renewal clock. `currentPeriodEnd` is the instant the renewal job becomes eligible to charge;
  // null while the team is on `free`. The job selects on it, hence the index.
  //
  // A CALENDAR CLOCK, NOT A 30-DAY ONE. The period advances by whole months from
  // `billingAnchorDay`, clamped to the length of the month it lands in, so a team that bought on
  // the 31st bills on the 28th in February and returns to the 31st in March. A fixed 30-day period
  // does neither: it walks the billing day backwards about five days a year, and it fits 12.17 of
  // them into a year on a package sold "per month".
  //
  // `currentPeriodStart` is the other end of that window, and what proration measures against —
  // an assumed period length cannot, because no two months are the same length.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  // Day of the month the package bills on, 1-31; null while the team is on `free`. Stored rather
  // than re-derived from `currentPeriodEnd`, because that date is CLAMPED: reading the anchor back
  // off a February 28th would move a 31st-of-the-month subscription there permanently.
  billingAnchorDay   Int?
  billingPeriod      BillingPeriod @default(monthly)
  autoRenew          Boolean       @default(true)
  lastRenewalAt      DateTime?
  // Why the last renewal attempt failed (e.g. "insufficient_credit"), for the dashboard banner.
  lastFailureCode    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

// --- Credit / wallet -------------------------------------------------------
//
// MONEY REPRESENTATION. Every USD amount in this schema is an integer count of CENTS, never a
// float. $10.00 is 1000. Floats cannot represent 0.1 exactly, and a balance that is repeatedly
// credited and debited would drift away from the ledger it is supposed to summarise.
//
// Crypto amounts are `Decimal(38, 18)` instead: 18 decimal places is the ETH/BEP20 wei precision,
// and 38 significant digits holds any realistic amount at that scale. A float would lose the low
// digits of a wei-denominated value outright.

// A team's Credit balance. Created lazily on first read so pre-existing teams don't need a backfill.
//
// `balanceCents` is a CACHED PROJECTION of `CreditTransaction`, not the source of truth. It exists
// because every profile-launch path would otherwise sum the whole ledger. It is only ever written
// inside the same transaction as the ledger row that justifies it, so the two cannot diverge; a
// reconciliation query (sum of amounts vs balance) is therefore a real integrity check.
model Wallet {
  teamId       String   @id
  balanceCents Int      @default(0)

  /// Agent spend that has been incurred but is not yet worth a whole cent, in MICRO-USD
  /// (1 cent = 10,000). A single Lobee call routinely costs a fraction of a cent, so charging each
  /// one to a whole-cent wallet would either overcharge a chatty session by an order of magnitude
  /// or, rounded the other way, make the agent free. Calls accumulate here and only whole cents are
  /// flushed to `balanceCents`, so the remainder survives both the next call and a restart.
  ///
  /// It also holds spend the balance could not cover, which is why it is not bounded by one cent.
  /// That debt is bounded instead by the pre-flight reserve check refusing the NEXT call, so it can
  /// never approach the Int ceiling (~$2,147).
  agentAccruedMicros Int @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  team         Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("wallets")
}

/// One metered Lobee call.
///
/// A ledger row for agent spend says "Lobee — 3¢" and can say nothing more: it is the sum of many
/// calls, flushed when the accrual crossed a cent. This table is what those cents were. Rows are
/// INSERTed and read, never updated — the same append-only discipline as the ledger, for the same
/// reason: it is evidence, and evidence that can be edited explains nothing.
///
/// `costMicros` and `chargedCents` disagree on almost every row, and that is the point — the
/// difference is the sub-cent remainder carried on `Wallet.agentAccruedMicros`.
model AgentUsage {
  id     String @id @default(uuid())
  teamId String

  /// The member whose session spent this; null for a system-originated run.
  userId    String?
  /// The browser profile the run drove, when it ran in one.
  profileId String?
  /// The Lobee run this call belonged to, so a whole run can be totalled from its calls.
  sessionId String?

  model String

  /// Total prompt tokens, with `cachedIn` as a SUBSET — the provider's own shape, kept verbatim so
  /// a row can be re-priced later against the table that was in force. Kept apart because they are
  /// billed at wildly different rates: output is several times fresh input, cached input a tenth.
  tokensIn  Int
  tokensOut Int
  cachedIn  Int

  /// What the call cost in micro-USD, margin already applied.
  costMicros   Int
  /// Whole cents this call flushed to the wallet — usually 0, occasionally 1 or more.
  chargedCents Int

  createdAt DateTime @default(now())

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  /// Every read of this table is one team over a time range — a statement line, a monthly total,
  /// or a dispute.
  @@index([teamId, createdAt])
  @@map("agent_usage")
}

// Append-only Credit ledger. Rows are INSERTed and read, never updated or deleted.
//
// `amountCents` is SIGNED: deposits and refunds are positive, purchases and renewals negative.
// `balanceAfterCents` records the resulting balance so a statement can be rendered without
// re-summing, and so a divergence can be traced to the exact row that introduced it.
model CreditTransaction {
  id                String       @id @default(uuid())
  teamId            String
  kind              CreditTxKind
  amountCents       Int
  balanceAfterCents Int
  // Human-readable one-liner for the statement, e.g. "Pro package — 200 profiles".
  description       String
  // Non-secret context: plan tier, deposit id, operator reason for adjustments.
  metadata          Json         @default("{}")
  createdAt         DateTime     @default(now())

  // Relations
  wallet Wallet @relation(fields: [teamId], references: [teamId], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@map("credit_transactions")
}

// An inbound crypto payment, from address issuance through to credited.
//
// IDEMPOTENCY. `providerPaymentId` is UNIQUE, and that constraint is the thing that makes webhook
// delivery safe. Processors retry aggressively and deliver out of order, so "confirmed" arrives
// more than once as a matter of course. Crediting is guarded by a null-check on `creditedAt`
// inside the same transaction that writes the ledger row, so a duplicate delivery finds the
// deposit already credited and becomes a no-op instead of minting Credit twice.
model Deposit {
  id                String        @id @default(uuid())
  teamId            String
  // Which processor produced this (e.g. "nowpayments"). Stored per-row, not assumed globally, so a
  // processor swap leaves historical rows correctly attributed and both can run at once.
  provider          String
  // The processor's own id for the payment. Unique across providers by construction (each
  // provider's ids are namespaced into this column as `<provider>:<id>`).
  providerPaymentId String        @unique
  status            DepositStatus @default(pending)

  // What the user ASKED to deposit, in USD cents, at the moment the address was issued. Kept so the
  // amount the webhook later claims can be reconciled against what was actually requested; without
  // it a wrong credit has nothing to be wrong against. Nullable for rows written before it existed.
  amountCents Int?

  // What the user actually sent.
  chain        String // "BSC", "TRON", "POLYGON", …
  asset        String // "USDT", "USDC", …
  amountCrypto Decimal? @db.Decimal(38, 18)
  address      String?
  txHash       String?

  // What it became, in USD cents, after the processor's conversion and fees. Null until confirmed.
  creditedCents Int?
  creditedAt    DateTime?

  /// When the credit was taken back, after the processor refunded or charged back a payment it had
  /// already settled. Nullable-timestamp for the same reason as `creditedAt`: it is the exactly-once
  /// guard as well as the record — the reversal claims the row by matching `reversedAt IS NULL`, so
  /// a redelivered refund callback cannot debit the wallet twice.
  reversedAt DateTime?

  // Raw provider payload of the last webhook, kept for dispute resolution. Non-secret: it holds
  // amounts, hashes and statuses, never API keys.
  providerPayload Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@index([status])
  @@map("deposits")
}

// --- Desktop authorisation -------------------------------------------------

// One-time authorisation code for the desktop launcher's loopback handoff (RFC 8252).
//
// FLOW. The launcher starts a listener on 127.0.0.1:<random port>, opens the browser at
// lobrowser.com/login?desktop=<state>&port=<port>, and waits. After the user authenticates, the
// site POSTs for a grant and redirects to http://127.0.0.1:<port>/callback?code=…, which the
// launcher exchanges for real tokens over HTTPS.
//
// WHY A CODE AND NOT THE TOKEN ITSELF. The redirect URL travels through the browser: it lands in
// history, and any other local process could have raced for the port. A code that is single-use,
// expires in minutes, and is redeemable only by the client that created it limits what capturing
// that URL is worth. `state` is bound at creation and re-checked at redemption, so a code minted
// for one launcher instance cannot be redeemed by another.
//
// PKCE (RFC 7636), AND WHY IT IS NOT OPTIONAL HERE. A loopback redirect has a hole the state
// parameter does not close: any local process can bind 127.0.0.1 on a port and receive the
// callback, and the OS offers no way for the browser to tell which process it reached. A hostile
// local listener would capture the code and redeem it for the user's session.
//
// So the launcher generates a random `verifier`, keeps it in memory, and sends only
// `codeChallenge = base64url(SHA256(verifier))` through the browser. Redemption requires the
// verifier itself, over HTTPS, directly from the launcher. A captured code is then worth nothing:
// the challenge is a one-way image of a secret that never entered the browser at all.
model DesktopAuthGrant {
  id        String   @id @default(uuid())
  // Opaque high-entropy code, stored HASHED — a database read must not yield a redeemable secret.
  codeHash  String   @unique
  // Echoed back to the launcher and re-checked on redemption (CSRF binding).
  state     String
  // base64url(SHA256(verifier)). See the PKCE note above.
  codeChallenge String
  userId    String
  expiresAt DateTime
  // Set the instant the code is redeemed; a second redemption finds it non-null and is refused.
  redeemedAt DateTime?
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("desktop_auth_grants")
}
