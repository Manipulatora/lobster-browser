# Lobster Browser — cloud backend environment.
# Copy to `.env` and fill in real values locally. NEVER commit `.env` (see root .gitignore).
# These are PLACEHOLDERS ONLY — do not put real secrets in this example file.

# HTTP port the API listens on (main.ts falls back to 8080 if unset).
PORT=8080

# --- Database (Postgres, consumed by Prisma `datasource`) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://lobster:lobster@localhost:5432/lobster?schema=public

# --- Auth ---
# Symmetric secret used to sign/verify JWTs. REQUIRED in production — the server refuses to start
# with the public dev secret when NODE_ENV=production. In dev/test it may be omitted (a dev secret
# is used). Leave DATABASE_URL unset locally to use the in-memory user store (no Postgres needed).
JWT_SECRET=replace-with-a-long-random-string

# --- Billing (Stripe) ---
# Server-side secret key (starts with sk_...). Used only by the billing module.
STRIPE_SECRET_KEY=sk_test_replace_me
# Webhook signing secret (starts with whsec_...) used to verify webhook payloads.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Encrypted profile blob storage (S3-compatible) ---
# Encrypted profile blobs live in object storage; Postgres only holds a reference + metadata.
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=lobster-profiles
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
