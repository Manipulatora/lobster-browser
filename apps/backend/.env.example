# Lobster Browser — cloud backend environment.
# Copy to `.env` and fill in real values locally. NEVER commit `.env` (see root .gitignore).
# These are PLACEHOLDERS ONLY — do not put real secrets in this example file.

# HTTP port the API listens on (main.ts falls back to 8080 if unset).
PORT=8080

# --- Database (Postgres, consumed by Prisma `datasource`) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://lobster:lobster@localhost:5432/lobster?schema=public

# --- Auth ---
# Symmetric secret used to sign/verify JWTs. REQUIRED in production — the server refuses to start
# with the public dev secret when NODE_ENV=production. In dev/test it may be omitted (a dev secret
# is used). Leave DATABASE_URL unset locally to use the in-memory user store (no Postgres needed).
JWT_SECRET=replace-with-a-long-random-string

# --- Billing (Stripe) ---
# Server-side secret key (starts with sk_...). Used only by the billing module.
STRIPE_SECRET_KEY=sk_test_replace_me
# Webhook signing secret (starts with whsec_...) used to verify webhook payloads.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Encrypted profile blob storage (S3-compatible) ---
# Encrypted profile blobs live in object storage; Postgres only holds a reference + metadata.
# Setting S3_BUCKET selects the real S3BlobStore; leave it unset to use the in-memory store
# (local dev / tests). For MinIO in dev: S3_ENDPOINT=http://localhost:9000 (path-style addressing
# is enabled automatically whenever a custom endpoint is set; override with S3_FORCE_PATH_STYLE).
# Omit the key pair to use the AWS SDK's default credential chain (IAM role, ~/.aws, env).
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=lobster-profiles
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
# Optional key namespace inside the bucket, e.g. "profiles" -> profiles/<team>/<profile>/<v>.enc
#S3_KEY_PREFIX=
# Optional: "true"/"false" to force/disable path-style URLs (defaults to true with S3_ENDPOINT).
#S3_FORCE_PATH_STYLE=

# --- Phone (Twilio: numbers + voice + SMS) ---
# Account SID (public identifier, starts with AC...).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Standard API Key (SK...) + its Secret. Used for REST auth AND to sign Voice access tokens.
# The secret is shown once in the Twilio console — store it here, never commit it.
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=replace-me
# TwiML Application SID (AP...) whose Voice URL is ${PUBLIC_BASE_URL}/twilio/voice/outbound?k=${TWILIO_WEBHOOK_SECRET}.
# Created once during setup (see docs/OPERATIONS.md); required for OUTBOUND calls from the SDK client.
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: account Auth Token. If set, inbound webhooks are verified with the real X-Twilio-Signature
# (strongest). If unset, verification falls back to the URL secret below.
#TWILIO_AUTH_TOKEN=
# Identity the Voice SDK client registers as; inbound PSTN calls are <Dial><Client>ed to it.
PHONE_CLIENT_IDENTITY=operator

# Public HTTPS base URL Twilio can reach THIS backend at. Used to build the number webhook URLs.
# On this VPS: https://158-220-91-217.nip.io (nip.io + Let's Encrypt — see docs/OPERATIONS.md).
PUBLIC_BASE_URL=https://158-220-91-217.nip.io
# High-entropy secret embedded in every webhook URL (?k=) so spoofed inbound posts are rejected.
# Generate: openssl rand -hex 24
TWILIO_WEBHOOK_SECRET=replace-with-openssl-rand-hex-24

# Static bearer token the desktop app sends to the operator-facing /phone/* endpoints (they spend
# money, so they must be protected). Generate: openssl rand -hex 24
PHONE_ACCESS_TOKEN=replace-with-openssl-rand-hex-24
