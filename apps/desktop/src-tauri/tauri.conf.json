{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lobster Browser",
  "version": "0.0.0",
  "identifier": "com.lobster.browser",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lobster Browser",
        "width": 1280,
        "height": 832,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
