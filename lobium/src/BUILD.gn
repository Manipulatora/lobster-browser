#
# Build target for the Lobium fingerprint config channel — the ADDED first-party module staged by
# build.sh into //components/lobium_fp. Consumers (Blink navigator, UA-CH provider, WebGL/canvas, net)
# depend on ":lobium_fp" (wired by core/build-gn.patch). Kept as an added directory so upstream rebases
# never reject it, and under //components (a first-party root) rather than //third_party so it is not
# swept by the third-party license/metadata scanner (tools/licenses).

source_set("lobium_fp") {
  sources = [
    "lobium_audio_farble.cc",
    "lobium_audio_farble.h",
    "lobium_capabilities.cc",
    "lobium_capabilities.h",
    "lobium_farble.cc",
    "lobium_farble.h",
    "lobium_fonts.cc",
    "lobium_fonts.h",
    "lobium_fp_config.cc",
    "lobium_fp_config.h",
    "lobium_media_devices.cc",
    "lobium_media_devices.h",
    "lobium_webgpu.cc",
    "lobium_webgpu.h",
  ]

  # public_deps: lobium_fp_config.h exposes base::FilePath (Load()) + includes base/files/file_path.h,
  # so //base is part of this target's public interface and must be re-exported to consumers.
  public_deps = [ "//base" ]

  # deps (not public_deps): lobium_media_devices.cc computes the persona deviceId with the same
  # HMAC-SHA256 construction Chrome uses in content/browser/media/media_devices_util.cc. //crypto is
  # an implementation detail - the header exposes only std::string - so consumers do not inherit it
  # and no Blink DEPS include-rule is needed.
  deps = [ "//crypto" ]
}

# The per-profile window icon, drawn with Skia in the browser process.
#
# A SEPARATE TARGET, deliberately. ":lobium_fp" is depended on by Blink core, Blink modules, Blink
# common and content/renderer, and this code needs //ui/gfx - the whole views-side text and canvas
# stack. Folding it into ":lobium_fp" would push that dependency into every renderer target that
# only wanted the fingerprint config, for the benefit of one browser-process caller.
source_set("lobium_profile_icon") {
  sources = [
    "lobium_profile_icon.cc",
    "lobium_profile_icon.h",
  ]

  # public_deps: the header returns gfx::ImageSkia by value, so //ui/gfx is part of this target's
  # public interface. It re-exports //base, //skia and //cc/paint, which is everything the
  # implementation needs.
  public_deps = [ "//ui/gfx" ]
}
