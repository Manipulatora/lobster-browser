+// Apply the non-observable native policy to an effective WebRTC configuration while retaining the
+// page-requested values getConfiguration() must echo. Both Create() and setConfiguration() use this
+// transform so reconfiguration cannot weaken proxy_only or disabled after construction.
+struct LobiumRequestedRtcConfiguration {
+  std::optional<webrtc::PeerConnectionInterface::IceTransportsType>
+      ice_transports;
+  std::optional<std::vector<webrtc::PeerConnectionInterface::IceServer>>
+      ice_servers;
+};
+
+LobiumRequestedRtcConfiguration ApplyLobiumWebRtcPolicy(
+    webrtc::PeerConnectionInterface::RTCConfiguration& configuration) {
+  LobiumRequestedRtcConfiguration requested;
+  const lobium::LobiumFpConfig* cfg = lobium::LobiumFpConfig::Current();
+  if (!cfg) {
+    return requested;
+  }
+
+  const bool proxy_only = cfg->net.webrtc_policy == "proxy_only";
+  const bool disabled = cfg->net.webrtc_policy == "disabled";
+  if (proxy_only || disabled) {
+    requested.ice_transports = configuration.type;
+    configuration.type = webrtc::PeerConnectionInterface::kRelay;
+  }
+  if (disabled) {
+    // Relay-only still gathers when the page supplies TURN. Clearing the effective server list is
+    // what prevents candidates reaching either the event or localDescription.sdp.
+    requested.ice_servers = configuration.servers;
+    configuration.servers.clear();
+  }
+  return requested;
+}
