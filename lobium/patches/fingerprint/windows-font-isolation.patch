+// Lobium: the profile's font pack, enumerated once per process.
+//
+// This is the "add" half of font isolation, and it is why a filter alone is not enough. A persona
+// claiming a consumer Windows 11 machine must be able to resolve fonts the HOST may not have
+// installed - a Windows Server VPS ships a visibly thinner set than a retail laptop, and a persona
+// measurably MISSING fonts is as much a tell as one carrying too many. Filtering can only subtract;
+// only real font files can add, so the launcher provisions a pack and names it in the config.
+//
+// Enumerated lazily and exactly once: DWriteFontProxyImpl is created per renderer, so doing this
+// per instance would re-stat the whole pack directory for every renderer the browser spawns.
+const std::vector<base::FilePath>& LobiumFontPackFaces() {
+  static base::NoDestructor<std::vector<base::FilePath>> faces([]() {
+    const lobium::LobiumFpConfig* cfg = lobium::LobiumFpConfig::Current();
+    if (!cfg || cfg->font_pack_dir.empty()) {
+      return std::vector<base::FilePath>();
+    }
+    base::ScopedBlockingCall scoped_blocking_call(
+        FROM_HERE, base::BlockingType::MAY_BLOCK);
+    return lobium::FontPackFaces(
+        base::FilePath::FromUTF8Unsafe(cfg->font_pack_dir));
+  }());
+  return *faces;
+}
