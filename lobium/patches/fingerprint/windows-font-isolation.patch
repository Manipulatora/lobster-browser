+sk_sp<SkFontMgr> CreateFontManager() {
+#if BUILDFLAG(IS_WIN)
+  const lobium::LobiumFpConfig* lobium_config =
+      lobium::LobiumFpConfig::Current();
+  const bool font_policy_active =
+      lobium_config &&
+      (!lobium_config->fonts.empty() || !lobium_config->font_pack_dir.empty());
+  Microsoft::WRL::ComPtr<IDWriteFactory> bootstrap_factory;
+  gfx::win::CreateDWriteFactory(&bootstrap_factory);
+  Microsoft::WRL::ComPtr<IDWriteFactory3> bootstrap_factory3;
+  if (bootstrap_factory) {
+    bootstrap_factory.As(&bootstrap_factory3);
+  }
+  if (bootstrap_factory3) {
+    Microsoft::WRL::ComPtr<IDWriteFontCollection> collection;
+    Microsoft::WRL::ComPtr<IDWriteFontFallback> fallback;
+    Microsoft::WRL::ComPtr<IDWriteFactory3> owning_factory;
+    const std::vector<base::FilePath>* test_faces =
+        gfx::win::GetSideloadedFontsForTesting();
+    const HRESULT hr =
+        test_faces ? lobium::CreateMergedFontCollectionWithExtraFaces(
+                         bootstrap_factory3.Get(), *test_faces, &collection,
+                         /*registered_pack_faces=*/nullptr, &owning_factory)
+                   : lobium::GetCachedMergedFontCollection(
+                         bootstrap_factory3.Get(), &collection,
+                         /*registered_pack_faces=*/nullptr, &owning_factory);
+    if (FAILED(hr) || !collection || !owning_factory) {
+      // Once a font policy has reached native code, falling back to
+      // DefaultFontMgr would expose the full host set. With no policy, retain
+      // Chromium's stock recovery behavior.
+      CHECK(!font_policy_active);
+      return skia::DefaultFontMgr();
+    }
+    const HRESULT fallback_hr =
+        lobium::GetCachedMergedFontFallback(owning_factory.Get(), &fallback);
+    if (FAILED(fallback_hr) || !fallback) {
+      CHECK(!font_policy_active);
+      return skia::DefaultFontMgr();
+    }
+    sk_sp<SkFontMgr> manager = SkFontMgr_New_DirectWrite(
+        owning_factory.Get(), collection.Get(), fallback.Get());
+    CHECK(manager);
+    return manager;
+  }
+  // A supported Windows build without a usable DirectWrite 3 factory cannot
+  // construct the restricted collection. Only the no-policy stock path may
+  // recover through the process default manager.
+  CHECK(!font_policy_active);
+#endif  // BUILDFLAG(IS_WIN)
+  return skia::DefaultFontMgr();
+}
