+HRESULT GetLocalFontCollection(mswr::ComPtr<IDWriteFactory3>& factory,
+                               IDWriteFontCollection** collection) {
+  if (!g_sideloaded_fonts && LobiumFontPackFaces().empty()) {
+    // Normal path - use the system's font collection with no sideloading.
+    return factory->GetSystemFontCollection(collection);
+  }
+
+  // Lobium: build the merged collection ONCE per process and hand every DWriteFontProxyImpl a
+  // reference to it.
+  //
+  // Chromium only ever sideloaded from tests, where a single instance and a couple of files made
+  // the cost invisible. A real font pack is a few hundred faces, and DWriteFontProxyImpl is created
+  // per renderer, so rebuilding the set per instance would mean hundreds of CreateFontFileReference
+  // + Analyze calls on every renderer's first font lookup - directly the browsing lag this build is
+  // meant not to have. The factory is DWRITE_FACTORY_TYPE_SHARED, and IDWriteFontCollection is
+  // read-only once built, so one instance is safely shared across sequences.
+  //
+  // Deliberately cached across font-installation changes: a collection that shifted mid-session
+  // would make the profile's font fingerprint unstable, and instability is more observable than
+  // being slightly stale.
+  struct CachedCollection {
+    mswr::ComPtr<IDWriteFontCollection> collection;
+  };
+  static base::NoDestructor<CachedCollection> cached([&factory]() {
+    CachedCollection built;
+    const HRESULT hr =
+        BuildSideloadedFontCollection(factory, &built.collection);
+    if (!SUCCEEDED(hr)) {
+      built.collection.Reset();
+    }
+    return built;
+  }());
+
+  if (!cached->collection) {
+    // Fail open. A malformed pack must degrade to the host's own fonts - still filtered by
+    // FindFamily - rather than to a browser with no font collection at all, which does not render.
+    return factory->GetSystemFontCollection(collection);
+  }
+  return cached->collection.CopyTo(collection);
+}
