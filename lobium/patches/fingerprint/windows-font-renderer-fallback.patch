+// Lobium(windows-font-renderer-fallback): companion to TypefacesMatchesFamily.
+// Windows font isolation serves a claimed family (e.g. "Segoe UI") out of a
+// metric-compatible physical pack face (e.g. "Liberation Sans"). The renderer
+// rebuilds its SkTypeface from those pack bytes, whose OWN family name is the
+// physical one, so TypefacesMatchesFamily() fails the requested name and the
+// caller falls all the way through to kLastResort -- normal text renders in the
+// wrong face. Accept the typeface when its own family name is a member of the
+// persona's physical pack inventory (LobiumFpConfig::font_fallback_families).
+// This is a renderer-safe membership test against the profile's own pack list;
+// it reveals nothing about the host.
+static bool TypefaceIsPackPhysicalFamily(const SkTypeface* tf) {
+  if (!tf) {
+    return false;
+  }
+  SkString family_name;
+  tf->getFamilyName(&family_name);
+  return lobium::FontFamilyIsPackPhysical(
+      std::string_view(family_name.c_str()));
+}
