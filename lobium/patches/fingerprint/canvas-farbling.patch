+// Lobium: return a seeded-farbled copy of a canvas READBACK snapshot (for
+// toDataURL/toBlob), or the original when `seed` is 0. `seed` is seeds.canvas
+// for a 2D canvas or seeds.webgl for a WebGL canvas; the WebGL path is
+// Y-flip-coherent with gl.readPixels because both key on the same top-down
+// origin. Reads into a private RGBA8888/unpremultiplied bitmap (unpremul so RGB
+// nudges can't create invalid premultiplied pixels) so the live canvas is never
+// touched; farbled at origin (0,0). Applied only at the toDataURL/toBlob encode
+// entries (NOT in Snapshot, which is also the drawImage/createImageBitmap
+// source), so ordinary rendering is untouched and farbling is never applied
+// twice.
+static scoped_refptr<StaticBitmapImage> LobiumFarbleReadback(
+    scoped_refptr<StaticBitmapImage> image,
+    uint32_t seed) {
+  if (!seed || !image) {
+    return image;
+  }
+  const gfx::Size sz = image->Size();
+  // Read back in the SOURCE canvas's colour space, not sRGB. Upstream carries
+  // the paint image's own colorType and colour space into the encoded pixmap
+  // (platform/graphics/image_data_buffer.cc), so forcing sRGB here re-encoded a
+  // display-p3 or rec2020 canvas as sRGB - every pixel shifted, on a path
+  // getImageData does not take. That makes toDataURL and getImageData disagree
+  // about the same canvas for a reason farbling cannot explain.
+  const SkImageInfo src_info =
+      image->PaintImageForCurrentFrame().GetSkImageInfo();
+  // The same guard getImageData already applies: an F16/F32 canvas must not be
+  // pushed through the RGBA8888 kernel, and must not be silently truncated to 8
+  // bits either. Leave it untouched.
+  if (src_info.colorType() != kRGBA_8888_SkColorType &&
+      src_info.colorType() != kBGRA_8888_SkColorType) {
+    return image;
+  }
+  const SkImageInfo info =
+      SkImageInfo::Make(sz.width(), sz.height(), kRGBA_8888_SkColorType,
+                        kUnpremul_SkAlphaType, src_info.refColorSpace());
+  SkBitmap bm;
+  if (bm.tryAllocPixels(info) &&
+      image->PaintImageForCurrentFrame().readPixels(info, bm.getPixels(),
+                                                    bm.rowBytes(), 0, 0)) {
+    lobium::FarbleCanvasRgba(static_cast<uint8_t*>(bm.getPixels()), sz.width(),
+                             sz.height(), bm.rowBytes(), 0, 0, seed);
+    if (sk_sp<SkImage> farbled = SkImages::RasterFromBitmap(bm)) {
+      return UnacceleratedStaticBitmapImage::Create(std::move(farbled));
+    }
+  }
+  return image;
+}
+
+// Lobium: pick the farbling seed for a canvas readback by context type - canvas
+// 2D vs WebGL are separate per-profile surfaces (seeds.canvas / seeds.webgl).
+// A transferControlToOffscreen placeholder has no local rendering context, so
+// its exported frame carries the worker producer's surface and provenance.
+// Returns 0 (no-op) for known page pixels, other contexts, or no config.
+static uint32_t LobiumReadbackSeed(const HTMLCanvasElement* canvas) {
+  const lobium::LobiumFpConfig* cfg = lobium::LobiumFpConfig::Current();
+  if (!cfg || !canvas) {
+    return 0u;
+  }
+  if (canvas->HasOffscreenCanvasFrame()) {
+    const ExportedCanvasResource* frame = canvas->OffscreenCanvasFrame();
+    if (!frame->LobiumHostEntropyDrawn()) {
+      return 0u;
+    }
+    switch (frame->LobiumReadbackSurfaceType()) {
+      case ExportedCanvasResource::LobiumReadbackSurface::kCanvas:
+        return cfg->seeds.canvas;
+      case ExportedCanvasResource::LobiumReadbackSurface::kWebGL:
+        return cfg->seeds.webgl;
+      case ExportedCanvasResource::LobiumReadbackSurface::kNone:
+        return 0u;
+    }
+  }
+  if (canvas->IsRenderingContext2D() ||
+      canvas->IsImageBitmapRenderingContext()) {
+    // Lobium: the same provenance gate getImageData uses. A 2D canvas built
+    // only from solid fillRects holds exactly the bytes the page wrote -
+    // identical on every host - so encoding it honestly costs no unlinkability,
+    // and farbling it would contradict getImageData, which is a tell in itself.
+    // Anything rasterised (text, paths, images, gradients, shadows, filters)
+    // sets the flag. A bitmaprenderer carries the source ImageBitmap's same
+    // bit. WebGL is unconditional below: its readback is always rasterised
+    // output.
+    const CanvasRenderingContext* context = canvas->RenderingContext();
+    if (context && !context->LobiumHostEntropyDrawn()) {
+      return 0u;
+    }
+    return cfg->seeds.canvas;
+  }
+  if (canvas->IsWebGL()) {
+    return cfg->seeds.webgl;
+  }
+  return 0u;
+}
