+// Lobium: return a seeded-farbled copy of a canvas READBACK snapshot (for toDataURL/toBlob), or the
+// original when `seed` is 0. `seed` is seeds.canvas for a 2D canvas or seeds.webgl for a WebGL canvas;
+// the WebGL path is Y-flip-coherent with gl.readPixels because both key on the same top-down origin.
+// Reads into a private RGBA8888/unpremultiplied bitmap (unpremul so RGB nudges can't create invalid
+// premultiplied pixels) so the live canvas is never touched; farbled at origin (0,0). Applied only at
+// the toDataURL/toBlob encode entries (NOT in Snapshot, which is also the drawImage/createImageBitmap
+// source), so ordinary rendering is untouched and farbling is never applied twice.
+static scoped_refptr<StaticBitmapImage> LobiumFarbleReadback(
+    scoped_refptr<StaticBitmapImage> image,
+    uint32_t seed) {
+  if (!seed || !image) {
+    return image;
+  }
+  const gfx::Size sz = image->Size();
+  const SkImageInfo info = SkImageInfo::Make(sz.width(), sz.height(), kRGBA_8888_SkColorType,
+                                             kUnpremul_SkAlphaType, SkColorSpace::MakeSRGB());
+  SkBitmap bm;
+  if (bm.tryAllocPixels(info) &&
+      image->PaintImageForCurrentFrame().readPixels(info, bm.getPixels(), bm.rowBytes(), 0, 0)) {
+    lobium::FarbleCanvasRgba(static_cast<uint8_t*>(bm.getPixels()), sz.width(), sz.height(),
+                             bm.rowBytes(), 0, 0, seed);
+    if (sk_sp<SkImage> farbled = SkImages::RasterFromBitmap(bm)) {
+      return UnacceleratedStaticBitmapImage::Create(std::move(farbled));
+    }
+  }
+  return image;
+}
+
+// Lobium: pick the farbling seed for a canvas readback by context type - canvas 2D vs WebGL are separate
+// per-profile surfaces (seeds.canvas / seeds.webgl); returns 0 (no-op) for other contexts or no config.
+static uint32_t LobiumReadbackSeed(const CanvasRenderingContextHost* host) {
+  const lobium::LobiumFpConfig* cfg = lobium::LobiumFpConfig::Current();
+  if (!cfg || !host) {
+    return 0u;
+  }
+  if (host->IsRenderingContext2D()) {
+    return cfg->seeds.canvas;
+  }
+  if (host->IsWebGL()) {
+    return cfg->seeds.webgl;
+  }
+  return 0u;
+}
