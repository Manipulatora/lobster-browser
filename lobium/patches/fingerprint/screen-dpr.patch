index 0d60244742..5b0f34d0a7 100644
--- a/third_party/blink/renderer/core/css/media_values.cc
+++ b/third_party/blink/renderer/core/css/media_values.cc
@@ -4,6 +4,7 @@
 
 #include "third_party/blink/renderer/core/css/media_values.h"
 
+#include "components/lobium_fp/lobium_fp_config.h"
 #include "third_party/blink/public/common/css/scripting.h"
 #include "third_party/blink/renderer/core/css/css_resolution_units.h"
 #include "third_party/blink/renderer/core/css/css_to_length_conversion_data.h"
@@ -193,6 +194,16 @@ bool MediaValues::CalculateStrictMode(LocalFrame* frame) {
 }
 
 float MediaValues::CalculateDevicePixelRatio(LocalFrame* frame) {
+  // Lobium: route the persona DPR through the CSS media-query resolution path too, so
+  // matchMedia('(resolution: Xdppx)') / '(-webkit-device-pixel-ratio)' AGREE with
+  // window.devicePixelRatio (overridden in LocalDOMWindow::devicePixelRatio). Without this the two
+  // disagree for any persona whose DPR != host DPR (e.g. a 2x retina persona on a 1x host) — a
+  // guaranteed, no-permission, trivially-scriptable lie a detector cross-checks. Hooking here (not
+  // LocalFrame::DevicePixelRatio) keeps real raster/layout scale untouched — only the queried value.
+  if (const lobium::LobiumFpConfig* cfg = lobium::LobiumFpConfig::Current();
+      cfg && cfg->screen.device_pixel_ratio > 0) {
+    return static_cast<float>(cfg->screen.device_pixel_ratio);
+  }
   return frame->DevicePixelRatio();
 }
 
