 void NavigatorLanguage::EnsureUpdatedLanguage() {
+  // Lobium: NavigatorLanguage backs Navigator and WorkerNavigator. Reading the config here therefore
+  // covers main frames, iframes, dedicated/shared workers, and service workers without a per-frame CDP
+  // override. Preserve configured order exactly.
+  if (const lobium::LobiumFpConfig* cfg = lobium::LobiumFpConfig::Current();
+      cfg && !cfg->navigator.languages.empty()) {
+    languages_.clear();
+    for (const std::string& language : cfg->navigator.languages)
+      languages_.push_back(String::FromUtf8(language));
+    languages_dirty_ = false;
+    return;
+  }
+
   String accept_languages_override;
   probe::ApplyAcceptLanguageOverride(execution_context_,
                                      &accept_languages_override);
