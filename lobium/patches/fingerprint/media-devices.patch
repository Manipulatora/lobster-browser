@@ -5,6 +5,7 @@
 #include "third_party/blink/renderer/modules/mediastream/media_devices.h"
 
 #include <algorithm>
+#include <string_view>
 #include <utility>
 
 #include "base/feature_list.h"
@@ -14,6 +15,8 @@
 #include "base/strings/stringprintf.h"
 #include "base/uuid.h"
 #include "build/build_config.h"
+#include "components/lobium_fp/lobium_fp_config.h"
+#include "components/lobium_fp/lobium_media_devices.h"
 #include "media/base/media_permission.h"
 #include "mojo/public/cpp/bindings/remote.h"
 #include "services/network/public/mojom/permissions_policy/permissions_policy_feature.mojom-blink.h"
@@ -1486,6 +1489,143 @@ void MediaDevices::DevicesEnumerated(
     }
   }
 
+  // Lobium: replace host device enumeration with the persona mediaDevices policy counts.
+  //
+  // SHAPE FIRST. The browser process is the permission gate
+  // (content/browser/media/media_devices_util.cc, TranslateMediaDeviceInfo): with the capture
+  // permission for a kind it hands the renderer a hashed deviceId, the real label and a groupId;
+  // without it, ONE entry for that kind with all three empty. There is no third state, so a persona
+  // that returns 64-hex deviceIds beside empty labels advertises the spoof instead of hiding it -
+  // a deviceId without permission cannot happen, and neither can a blank label after a grant. That
+  // already-gated answer is still in `enumeration`, so the persona list is shaped by reading the
+  // grant back out of it rather than by a config flag.
+  //
+  // The identifiers use the SAME construction as Chrome (GetHMACForRawMediaDeviceID): HMAC-SHA256
+  // keyed on the requesting ORIGIN over a per-profile salt, hex-encoded lowercase - 64 characters.
+  // Three properties of that matter, and the first implementation had none of them:
+  //
+  //   * LENGTH. Chrome emits 64 hex chars (a full SHA-256). The old id was 32, which is a length no
+  //     Chrome build produces.
+  //   * PER-ORIGIN. Because the origin is the HMAC key, the same physical device reports a DIFFERENT
+  //     id to every site. The old id was origin-independent, so two of an attacker's own domains
+  //     could compare ids and correlate the visitor - something a real browser never allows.
+  //   * ENTROPY. The old id XORed one 32-bit value with a per-word constant, so it carried ~16 bits
+  //     and any two words of it recovered the seed.
+  if (const lobium::LobiumFpConfig* cfg = lobium::LobiumFpConfig::Current();
+      cfg && cfg->media_devices.present) {
+    const auto& md = cfg->media_devices;
+
+    // A non-empty device_id anywhere in the browser's answer for a kind IS the grant for that kind,
+    // because the gate above blanks every field when it is missing. Reading it back is the only
+    // route available here: a renderer cannot query permission state synchronously.
+    auto kind_permitted = [&enumeration](mojom::blink::MediaDeviceType type) {
+      for (const WebMediaDeviceInfo& info :
+           enumeration[static_cast<wtf_size_t>(type)]) {
+        if (!info.device_id.empty()) {
+          return true;
+        }
+      }
+      return false;
+    };
+
+    media_devices.clear();
+    result_contains_nonempty_input_device_ids = false;
+
+    // The HMAC key. An opaque origin serializes to "null", which is exactly what Chrome keys on for
+    // a sandboxed frame, so the behaviour matches there too.
+    ExecutionContext* context = GetExecutionContext();
+    const std::string origin =
+        context ? context->GetSecurityOrigin()->ToString().Utf8() : std::string("null");
+    const std::string salt =
+        md.stable_device_ids ? lobium::MediaDeviceSaltFromSeed(cfg->seeds.media_devices)
+                             : lobium::MediaDeviceEphemeralSalt();
+    const std::string& platform = cfg->navigator.ua_platform;
+
+    auto push_device = [&](mojom::blink::MediaDeviceType type, std::string_view kind_key,
+                           std::string_view group_key, int index, std::string_view pseudo) {
+      // Chrome passes the "default" and "communications" pseudo-devices through unhashed and gives
+      // them the group of the real device they point at, which is why they are pushed at index 0.
+      const String id =
+          pseudo.empty() ? String::FromUtf8(lobium::MediaDeviceHmacId(
+                               origin, salt, kind_key, index, /*group=*/false))
+                         : String::FromUtf8(pseudo);
+      const String group = String::FromUtf8(
+          lobium::MediaDeviceHmacId(origin, salt, group_key, index, /*group=*/true));
+      const String label =
+          String::FromUtf8(lobium::MediaDeviceLabel(platform, kind_key, index, pseudo));
+      if (type == mojom::blink::MediaDeviceType::kMediaAudioInput ||
+          type == mojom::blink::MediaDeviceType::kMediaVideoInput) {
+        result_contains_nonempty_input_device_ids = true;
+        media_devices.push_back(
+            MakeGarbageCollected<InputDeviceInfo>(id, label, group, type));
+      } else {
+        media_devices.push_back(
+            MakeGarbageCollected<MediaDeviceInfo>(id, label, group, type));
+      }
+    };
+
+    // The no-permission answer: one entry, every field empty. The device COUNT is withheld with the
+    // ids, because the count is only observable after a grant in a real browser too.
+    auto push_blank = [&](mojom::blink::MediaDeviceType type) {
+      if (type == mojom::blink::MediaDeviceType::kMediaAudioInput ||
+          type == mojom::blink::MediaDeviceType::kMediaVideoInput) {
+        media_devices.push_back(MakeGarbageCollected<InputDeviceInfo>(
+            String(), String(), String(), type));
+      } else {
+        media_devices.push_back(MakeGarbageCollected<MediaDeviceInfo>(
+            String(), String(), String(), type));
+      }
+    };
+
+    // Microphones and speakers share the "audio" group domain because
+    // AudioManagerBase::GetGroupIDInput resolves an input to its ASSOCIATED output's group: on
+    // integrated hardware the mic and the speakers of one machine report the SAME groupId, and a
+    // persona whose kinds never share one is describing a machine with no built-in sound card.
+    auto push_audio_kind = [&](mojom::blink::MediaDeviceType type, std::string_view kind_key,
+                               int count) {
+      if (count <= 0) {
+        return;
+      }
+      if (!kind_permitted(type)) {
+        push_blank(type);
+        return;
+      }
+      // Every desktop AudioManager prepends the virtual "default" device, and Windows also prepends
+      // "communications" (media/audio/win/audio_manager_win.cc). A persona lacking them is missing
+      // entries every real browser on that OS reports.
+      push_device(type, kind_key, "audio", 0, "default");
+      if (platform == "Windows") {
+        push_device(type, kind_key, "audio", 0, "communications");
+      }
+      // Android stops there: AudioManagerAndroid enumerates the default device and nothing else, so
+      // listing the physical ones would list entries Android never reports.
+      if (platform == "Android") {
+        return;
+      }
+      for (int i = 0; i < count; ++i) {
+        push_device(type, kind_key, "audio", i, std::string_view());
+      }
+    };
+
+    // Emitted in MediaDeviceType order, the order the loop above uses, so the persona list arrives
+    // grouped the way every real enumeration is.
+    push_audio_kind(mojom::blink::MediaDeviceType::kMediaAudioInput, "audioinput",
+                    md.microphones);
+    if (md.cameras > 0) {
+      if (kind_permitted(mojom::blink::MediaDeviceType::kMediaVideoInput)) {
+        // A camera is a physical unit of its own, so each one gets its own group.
+        for (int i = 0; i < md.cameras; ++i) {
+          push_device(mojom::blink::MediaDeviceType::kMediaVideoInput, "videoinput",
+                      "videoinput", i, std::string_view());
+        }
+      } else {
+        push_blank(mojom::blink::MediaDeviceType::kMediaVideoInput);
+      }
+    }
+    push_audio_kind(mojom::blink::MediaDeviceType::kMediaAudioOutput, "audiooutput",
+                    md.speakers);
+  }
+
   ReportCompletedEnumerateDevices(result_contains_nonempty_input_device_ids);
   result_tracker->Resolve(media_devices);
   tracer->End();
