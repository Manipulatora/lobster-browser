@@ -3411,6 +3472,40 @@ gfx::RectF Element::GetBoundingClientRectNoLifecycleUpdate() const {
 DOMRect* Element::GetBoundingClientRect() {
   GetDocument().EnsurePaintLocationDataValidForNode(
       this, DocumentUpdateReason::kJavaScript);
+  // Lobium: the box is built as the UNION of the farbled client rects rather than by farbling the
+  // union, so getBoundingClientRect() == union(getClientRects()) survives farbling the way it holds
+  // in every honest browser. Adjusting each rect and then unioning gives the same geometry as
+  // GetBoundingClientRectNoLifecycleUpdate()'s union-then-adjust, because
+  // AdjustRectForScrollAndAbsoluteZoom is affine; the quads are walked here rather than through
+  // GetClientRectsNoAdjustment() so the scroll-access heuristic is not counted twice for one call.
+  if (const lobium::LobiumFpConfig* cfg = lobium::LobiumFpConfig::Current();
+      cfg && cfg->seeds.client_rects) {
+    Vector<gfx::QuadF> quads;
+    ClientQuads(quads);
+    gfx::RectF unadjusted;
+    for (const auto& quad : quads) {
+      unadjusted.Union(quad.BoundingBox());
+    }
+    // An empty box short-circuits upstream before the adjustment, so it must here too.
+    if (unadjusted != gfx::RectF()) {
+      LayoutObject* element_layout_object = GetLayoutObject();
+      DCHECK(element_layout_object);
+      Vector<gfx::RectF> rects;
+      rects.ReserveInitialCapacity(quads.size());
+      for (const auto& quad : quads) {
+        gfx::RectF rect = quad.BoundingBox();
+        GetDocument().AdjustRectForScrollAndAbsoluteZoom(rect,
+                                                         *element_layout_object);
+        rects.push_back(rect);
+      }
+      LobiumFarbleClientRects(*this, cfg->seeds.client_rects, rects);
+      gfx::RectF result;
+      for (const gfx::RectF& rect : rects) {
+        result.Union(rect);
+      }
+      return DOMRect::FromRectF(result);
+    }
+  }
   return DOMRect::FromRectF(GetBoundingClientRectNoLifecycleUpdate());
 }
 
