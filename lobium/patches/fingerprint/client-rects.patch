+            ShouldTrackFractionOfRoot() ? root_rect_ : target_rect_;
+        const bool empty_override =
+            !ShouldTrackFractionOfRoot() && pre_margin_target_rect_is_empty;
+        if (comparison_rect.IsEmpty() || empty_override) {
+          intersection_ratio_ = 1;
+        } else {
+          const float intersection_area = intersection_rect_.size().GetArea();
+          const float area_of_interest = comparison_rect.size().GetArea();
+          intersection_ratio_ =
+              std::min(intersection_area / area_of_interest, 1.f);
+        }
+        threshold_index_ =
+            FirstThresholdGreaterThan(intersection_ratio_, thresholds);
+      } else {
+        intersection_ratio_ = 0;
+        threshold_index_ = 0;
+      }
