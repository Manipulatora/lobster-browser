+  if (const lobium::LobiumFpConfig* cfg = lobium::LobiumFpConfig::Current();
+      cfg && cfg->seeds.client_rects && target->GetNode()) {
+    const uint32_t seed = cfg->seeds.client_rects;
+    auto farble_for_element = [&](gfx::RectF& rect, const Element& element) {
+      const ComputedStyle* style = element.GetComputedStyle();
+      if (!style || !lobium::ClientRectCarriesHostEntropy(
+                        rect.width(), rect.height(), style->Width().IsFixed(),
+                        style->Height().IsFixed())) {
+        return false;
+      }
+      float x = rect.x(), y = rect.y(), width = rect.width(), height = rect.height();
+      lobium::FarbleClientRect(&x, &y, &width, &height, seed);
+      rect.SetRect(x, y, width, height);
+      return true;
+    };
+
+    bool did_farble = false;
+    if (const auto* target_element = DynamicTo<Element>(target->GetNode())) {
+      // Each target-derived rect is judged on its own geometry, exactly as the client-rect list is.
+      did_farble |= farble_for_element(target_rect_, *target_element);
+      did_farble |= farble_for_element(intersection_rect_, *target_element);
+    }
+    // An explicit Element root exposes rootBounds through the same entry. Farbling only the target
+    // and intersection would leave that third layout-derived rectangle as both a leak and a direct
+    // contradiction when the target fills the root. Implicit viewport and Document roots are not
+    // Elements and stay untouched.
+    if (!RootIsImplicit() && root->GetNode()) {
+      if (const auto* root_element = DynamicTo<Element>(root->GetNode())) {
+        did_farble |= farble_for_element(root_rect_, *root_element);
+      }
+    }
+
+    if (did_farble) {
+      // Upstream calculated these fields from the pre-farbling rectangles. Recalculate both from
+      // the values the entry actually exposes; otherwise intersectionRatio disagrees with the two
+      // visible areas and threshold callbacks describe a different ratio from the callback entry.
+      if (does_intersect) {
