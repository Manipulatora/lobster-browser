@@ -35,6 +38,8 @@
 #include "third_party/blink/renderer/core/dom/dom_exception.h"
 #include "third_party/blink/renderer/core/execution_context/execution_context.h"
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/typed_arrays/dom_typed_array.h"
+#include "third_party/blink/renderer/modules/webaudio/audio_buffer.h"
 #include "third_party/blink/renderer/modules/webaudio/audio_listener.h"
 #include "third_party/blink/renderer/modules/webaudio/deferred_task_handler.h"
 #include "third_party/blink/renderer/modules/webaudio/offline_audio_completion_event.h"
@@ -432,6 +437,30 @@ void OfflineAudioContext::FireCompletionEvent() {
       return;
     }
 
+    // Lobium: seeded audio-fingerprint farbling. The offline render is COMPLETE and this main-thread
+    // event runs exactly once per context; the render thread already posted NotifyComplete before this
+    // runs, so nothing else aliases these buffers now. We perturb the finished RESULT backing store in
+    // place, once, keyed per (seed, channel, sample index). getChannelData(), copyFromChannel(), and
+    // event.renderedBuffer all read THIS same store, so every readback path agrees by construction — no
+    // per-call compounding, object identity preserved. This buffer is a readback artifact (the output
+    // of startRendering()); we never touch the realtime graph or any playback source. This is the #1
+    // audio fingerprint vector (OfflineAudioContext + DynamicsCompressor -> sample sum/hash).
+    if (const lobium::LobiumFpConfig* cfg = lobium::LobiumFpConfig::Current();
+        cfg && cfg->seeds.audio) {
+      const unsigned channels = rendered_buffer->numberOfChannels();
+      for (unsigned ch = 0; ch < channels; ++ch) {
+        base::span<float> data = rendered_buffer->getChannelData(ch)->AsSpan();
+        // Use the SAME (seed, sample index) key for every channel — NOT a per-channel seed fold.
+        // Honest Chrome upmixes a mono source to bit-identical L/R channels; a per-channel seed would
+        // make them diverge, which `channelData(0)[k] === channelData(1)[k]` detects as a cheap farble
+        // oracle. Applying one eps sequence to all channels keeps identical channels identical (the
+        // (1+eps) factor cancels in channel0[k]/channel1[k], matching the honest ratio) while genuinely
+        // distinct channels still farble distinctly (different underlying samples). It also removes the
+        // channel-fold-hits-zero-sentinel edge case that could leave one channel unfarbled.
+        lobium::FarbleAudioSamples(data.data(), data.size(), /*base_index=*/0, cfg->seeds.audio);
+      }
+    }
+
     // Call the offline rendering completion event listener and resolve the
     // promise too.
     DispatchEvent(*OfflineAudioCompletionEvent::Create(rendered_buffer));
