+// Copyright 2026 The Lobster Browser Authors.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_LOBIUM_DEVICE_FRAME_VIEW_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_LOBIUM_DEVICE_FRAME_VIEW_H_
+
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/views/view.h"
+
+class BrowserView;
+
+namespace content {
+class WebContents;
+}
+
+// Native Android device workspace shown inside a normal Lobium browser window.
+// The real WebContents is a sibling laid inside a thin device outline.
+//
+// The stage auto-fits the browser content area and owns window-level zoom. The
+// native aperture and DevTools emulation image scale move together, while the
+// emulated CSS screen/view dimensions and DPR stay exactly as configured.
+class LobiumDeviceFrameView : public views::View {
+  METADATA_HEADER(LobiumDeviceFrameView, views::View)
+
+ public:
+  explicit LobiumDeviceFrameView(BrowserView* browser_view);
+  LobiumDeviceFrameView(const LobiumDeviceFrameView&) = delete;
+  LobiumDeviceFrameView& operator=(const LobiumDeviceFrameView&) = delete;
+  ~LobiumDeviceFrameView() override;
+
+  static bool IsEnabled();
+
+  // Returns BrowserView coordinates for the real interactive WebContents
+  // aperture.
+  gfx::Rect GetDeviceScreenBounds(const gfx::Rect& workspace);
+
+  // Handles the browser's Ctrl +/-/0 commands as device-stage zoom instead of
+  // per-page zoom. Returns false only when the requested limit is reached.
+  bool ZoomIn();
+  bool ZoomOut();
+  bool ResetZoom();
+
+  // Reapplies the current stage scale to a newly selected/attached tab.
+  void ApplyCurrentScaleToWebContents(content::WebContents* web_contents);
+
+ private:
+  struct Geometry {
+    gfx::Rect frame;
+    gfx::Rect screen;
+    float scale = 1.0f;
+  };
+
+  Geometry CalculateGeometry(const gfx::Rect& local_workspace) const;
+  bool SetZoomStep(int step);
+  void SyncEmulationScale(base::WeakPtr<content::WebContents> web_contents,
+                          float scale,
+                          int attempts_remaining);
+  void ScheduleEmulationScaleSync(content::WebContents* web_contents,
+                                  float scale);
+
+  // Vertical scrollbar (only present when the zoomed device is taller than the
+  // stage). Returns the track rect in this view's coordinates, or an empty rect
+  // when there is nothing to scroll.
+  gfx::Rect ScrollTrackBounds() const;
+  gfx::Rect ScrollThumbBounds() const;
+  // Moves the stage so the given local Y sits at the middle of the thumb.
+  void ScrollToThumbCenterY(int local_y);
+
+  // views::View:
+  void OnPaint(gfx::Canvas* canvas) override;
+  bool OnMousePressed(const ui::MouseEvent& event) override;
+  bool OnMouseDragged(const ui::MouseEvent& event) override;
+  bool OnMouseWheel(const ui::MouseWheelEvent& event) override;
+
+  raw_ptr<BrowserView> browser_view_;
+  int zoom_step_ = 0;
+  float current_scale_ = 1.0f;
+  // Vertical stage scroll offset (in stage pixels) used when the zoomed device
+  // is taller than the content area. max_scroll_ is the largest valid offset and
+  // is recomputed by CalculateGeometry (hence mutable — that method is const).
+  int scroll_offset_ = 0;
+  mutable int max_scroll_ = 0;
+  base::WeakPtrFactory<LobiumDeviceFrameView> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_LOBIUM_DEVICE_FRAME_VIEW_H_
