+#include "chrome/browser/ui/views/frame/lobium_device_frame_view.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <string>
+#include <vector>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/task/sequenced_task_runner.h"
+#include "base/time/time.h"
+#include "cc/paint/paint_flags.h"
+#include "chrome/browser/ui/views/frame/browser_view.h"
+#include "content/public/browser/lobium_device_emulation.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+#include "ui/events/event.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/insets.h"
+#include "ui/gfx/geometry/rect_f.h"
+
+namespace {
+
+constexpr char kDeviceFrameSwitch[] = "lobium-device-frame";
+constexpr char kDeviceScreenSwitch[] = "lobium-device-screen";
+// A small breathing margin between the phone/tablet shell and the browser
+// content area; kept modest so the device is as large as the shared scale
+// allows.
+constexpr int kStagePadding = 16;
+// Hairline device outline. Painted as a 1px stroke (see OnPaint) so the phone frame is a thin line, not
+// a heavy bezel, and does not thicken with zoom.
+constexpr float kFrameBorder = 1.0f;
+
+// Reserved strip at the RIGHT edge of the stage for the vertical scrollbar, shown
+// only when the zoomed device is taller than the content area. The aperture width
+// is clamped to leave this gutter so the scrollbar — painted by this view, which
+// sits behind the WebContents — stays visible and clickable.
+constexpr int kScrollbarGutter = 16;
+constexpr int kScrollbarThumbWidth = 6;
+constexpr int kScrollbarMinThumb = 28;
+constexpr int kScrollWheelStep = 90;
+
+// Multipliers around the native fit-to-window scale. Keeping these discrete
+// mirrors Chromium's familiar Ctrl +/- behavior without mutating page zoom.
+constexpr std::array<float, 15> kZoomMultipliers = {
+    0.25f, 0.33f, 0.50f, 0.67f, 0.75f, 0.80f, 0.90f, 1.00f,
+    1.10f, 1.25f, 1.50f, 1.75f, 2.00f, 2.50f, 3.00f};
+constexpr int kDefaultZoomStep = 7;
+
+gfx::Size DeviceScreen() {
+  const std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kDeviceScreenSwitch);
+  const std::vector<std::string> parts = base::SplitString(
+      value, "x", base::KEEP_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  int width = 0;
+  int height = 0;
+  if (parts.size() != 2 || !base::StringToInt(parts[0], &width) ||
+      !base::StringToInt(parts[1], &height) || width <= 0 || height <= 0) {
+    return gfx::Size(393, 873);
+  }
+  return gfx::Size(width, height);
+}
+
+// Scale at which the device exactly fills the stage (content area minus padding). This is the hard
+// upper bound for the device scale: beyond it the frame + WebContents aperture would exceed the stage
+// and, being centered, spill over the toolbar/window chrome.
+float FillScale(const gfx::Rect& workspace) {
+  const gfx::Size screen = DeviceScreen();
+  gfx::Rect available = workspace;
+  available.Inset(gfx::Insets(kStagePadding));
+  const float natural_width = screen.width() + kFrameBorder * 2.0f;
+  const float natural_height = screen.height() + kFrameBorder * 2.0f;
+  return std::max(0.05f, std::min(available.width() / natural_width,
+                                  available.height() / natural_height));
+}
+
+}  // namespace
+
+LobiumDeviceFrameView::LobiumDeviceFrameView(BrowserView* browser_view)
+    : browser_view_(browser_view), zoom_step_(kDefaultZoomStep) {}
+
+LobiumDeviceFrameView::~LobiumDeviceFrameView() = default;
+
+bool LobiumDeviceFrameView::IsEnabled() {
+  const std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          kDeviceFrameSwitch);
+  return value == "phone" || value == "tablet";
+}
+
+LobiumDeviceFrameView::Geometry LobiumDeviceFrameView::CalculateGeometry(
+    const gfx::Rect& local_workspace) const {
+  const gfx::Size screen = DeviceScreen();
+  const float border = kFrameBorder;
+  gfx::Rect available = local_workspace;
+  available.Inset(gfx::Insets(kStagePadding));
+  const float natural_width = screen.width() + border * 2.0f;
+  const float natural_height = screen.height() + border * 2.0f;
+
+  // The default (zero) step fits the device to the current content area, capped at 1:1. The 1:1 cap is
+  // what makes the phone fit its frame on first paint: the sidecar's DevTools device-emulation scale is
+  // itself clamped to <=1.0 (Math.min(1, ...) in device-frame.ts), so both sides independently land on
+  // the SAME default scale (min(fit, 1.0)) with no async handshake, avoiding the old ~8% bottom gap.
+  const float fill_scale = FillScale(local_workspace);
+  const float base = std::min(1.0f, fill_scale);
+  // User zoom multiplies around the base fit and MAY exceed fill — the device deliberately grows LARGER
+  // than the stage on zoom-in (that is what "zoom in" must do). Overrun is kept off the browser chrome by
+  // clamping the device POSITION below, not by capping the scale, so zoom-in is never a no-op.
+  const float scale =
+      std::clamp(base * kZoomMultipliers[zoom_step_], 0.05f, 10.0f);
+
+  const gfx::Size frame_size(std::lround(natural_width * scale),
+                             std::lround(natural_height * scale));
+
+  // Vertical overflow: the zoomed device is taller than the content area. Expose a
+  // scrollbar and let the user scroll the stage down instead of clipping the lower
+  // part of the phone off-screen under the window edge.
+  const int overflow_y = std::max(0, frame_size.height() - available.height());
+  max_scroll_ = overflow_y;
+  const int scroll = std::clamp(scroll_offset_, 0, overflow_y);
+
+  // Center the device while it fits the stage. Horizontally, once it is wider than the stage, PIN its left
+  // edge inside the stage so it can never ride off the left — it overflows right, where the window clips
+  // it. Vertically, when it overflows PIN the top and move UP by the scroll offset (so scrolling down
+  // reveals the lower part); otherwise center it. This keeps the phone off the toolbar/omnibox while
+  // letting zoom-in enlarge it and the scrollbar reach the bottom.
+  const int fx = std::max(available.x(),
+                          available.x() + (available.width() - frame_size.width()) / 2);
+  const int fy =
+      overflow_y > 0
+          ? available.y() - scroll
+          : std::max(available.y(),
+                     available.y() + (available.height() - frame_size.height()) / 2);
+  const gfx::Rect frame(fx, fy, frame_size.width(), frame_size.height());
+  gfx::Rect screen_bounds = frame;
+  // Fixed 1px aperture inset (NOT border*scale) so the outline stays a hairline at every zoom level and
+  // the WebContents aperture aligns with the 1px ring drawn in OnPaint.
+  screen_bounds.Inset(std::max(1, static_cast<int>(std::lround(border))));
+  // When scrolling is active, keep the aperture's right edge clear of the scrollbar
+  // gutter so the scrollbar (painted behind the WebContents) is not covered and can
+  // receive mouse events.
+  if (overflow_y > 0) {
+    const int max_right = available.right() - kScrollbarGutter;
+    if (screen_bounds.right() > max_right) {
+      screen_bounds.set_width(std::max(1, max_right - screen_bounds.x()));
+    }
+  }
+  return {frame, screen_bounds, scale};
+}
+
+gfx::Rect LobiumDeviceFrameView::GetDeviceScreenBounds(
+    const gfx::Rect& workspace) {
+  const Geometry geometry = CalculateGeometry(gfx::Rect(workspace.size()));
+  if (std::abs(current_scale_ - geometry.scale) > 0.0001f) {
+    current_scale_ = geometry.scale;
+    ScheduleEmulationScaleSync(browser_view_->GetActiveWebContents(),
+                               current_scale_);
+  }
+  return geometry.screen + workspace.OffsetFromOrigin();
+}
+
+bool LobiumDeviceFrameView::SetZoomStep(int step) {
+  const int clamped = std::clamp(step, 0,
+                                 static_cast<int>(kZoomMultipliers.size()) - 1);
+  if (clamped == zoom_step_) {
+    return false;
+  }
+  zoom_step_ = clamped;
+  // Reset the stage scroll on every zoom change so the view predictably re-centers
+  // on (or pins to) the top of the device rather than staying scrolled mid-phone.
+  scroll_offset_ = 0;
+  browser_view_->InvalidateLayout();
+  SchedulePaint();
+  return true;
+}
+
+bool LobiumDeviceFrameView::ZoomIn() {
+  // Always advance: the device is allowed to grow past the stage (CalculateGeometry pins its top-left so
+  // it overflows into the window's clip region, not over the chrome), so zoom-in is never a no-op.
+  return SetZoomStep(zoom_step_ + 1);
+}
+
+bool LobiumDeviceFrameView::ZoomOut() {
+  return SetZoomStep(zoom_step_ - 1);
+}
+
+bool LobiumDeviceFrameView::ResetZoom() {
+  return SetZoomStep(kDefaultZoomStep);
+}
+
+void LobiumDeviceFrameView::SyncEmulationScale(
+    base::WeakPtr<content::WebContents> web_contents,
+    float scale,
+    int attempts_remaining) {
+  // Ignore delayed work from an older window size or zoom step: a newer layout
+  // has since changed current_scale_ and started its own retry chain.
+  if (!web_contents || std::abs(current_scale_ - scale) > 0.0001f) {
+    return;
+  }
+  // SetLobiumDeviceEmulationScale only carries the scale (merge-only) and returns
+  // false while Blink device emulation is not yet enabled. The sidecar enables it
+  // AFTER endpoint-ready + cookie import, so the aperture's fit scale is computed
+  // (at first layout) before there is anything to push it to. Retry until the push
+  // actually lands — otherwise the emulated image stays at the sidecar's bootstrap
+  // scale (1.0) while the native aperture sits at the real fit (~1.10), leaving the
+  // ~8% bottom gap that previously only a manual Ctrl+zoom could correct.
+  if (content::SetLobiumDeviceEmulationScale(web_contents.get(), scale)) {
+    // The scale landed — Blink device emulation is now enabled for this (possibly brand-new) tab. Re-fit
+    // the aperture and repaint so the WebContents covers the whole device screen. Without this, a new tab
+    // created while zoomed in stayed at the bootstrap scale until a manual zoom, leaving the phone screen
+    // partly dark.
+    browser_view_->InvalidateLayout();
+    SchedulePaint();
+    return;
+  }
+  if (attempts_remaining <= 0) {
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&LobiumDeviceFrameView::SyncEmulationScale,
+                     weak_factory_.GetWeakPtr(), web_contents, scale,
+                     attempts_remaining - 1),
+      base::Milliseconds(100));
+}
+
+void LobiumDeviceFrameView::ScheduleEmulationScaleSync(
+    content::WebContents* web_contents,
+    float scale) {
+  if (!web_contents) {
+    return;
+  }
+  // One self-terminating chain (100ms x 240 ≈ up to 24s) rather than a fixed
+  // burst: it tries immediately, then keeps retrying only until emulation is
+  // enabled and the scale lands, so it wins regardless of how late the sidecar
+  // turns emulation on. The fast 100ms cadence shrinks the window in which a
+  // freshly created tab shows a dark emulation letterbox before the stage scale
+  // lands. A newer layout/zoom starts a fresh chain and the current_scale_ guard
+  // abandons this stale one.
+  constexpr int kMaxAttempts = 240;
+  SyncEmulationScale(web_contents->GetWeakPtr(), scale, kMaxAttempts);
+}
+
+void LobiumDeviceFrameView::ApplyCurrentScaleToWebContents(
+    content::WebContents* web_contents) {
+  // A new tab starts at the top of the device.
+  scroll_offset_ = 0;
+  // Recompute the CURRENT stage fit-scale from live geometry (not the possibly
+  // stale current_scale_) and arm the emulation-scale sync directly for THIS tab,
+  // which may be brand new. The sync retries until the sidecar has enabled device
+  // emulation on the tab, then pushes this scale so the emulated image fills the
+  // whole aperture. Without a correct scale, a tab created while zoomed in kept the
+  // sidecar's bootstrap fit-scale and showed a dark emulation letterbox in the part
+  // of the aperture the smaller image did not cover — until a manual zoom re-armed
+  // the sync. Setting current_scale_ here keeps the retry guard consistent.
+  const float scale = CalculateGeometry(GetLocalBounds()).scale;
+  current_scale_ = scale;
+  ScheduleEmulationScaleSync(web_contents, scale);
+  // Re-fit + repaint immediately on tab switch (the zoom path already does this via SetZoomStep).
+  browser_view_->InvalidateLayout();
+  SchedulePaint();
+}
+
+void LobiumDeviceFrameView::OnPaint(gfx::Canvas* canvas) {
+  views::View::OnPaint(canvas);
+  // Neutral desk behind the device.
+  canvas->DrawColor(SkColorSetRGB(246, 248, 251));
+
+  const Geometry geometry = CalculateGeometry(GetLocalBounds());
+  // Paint ONLY a thin border ring around the device screen — not a filled rectangle. The real WebContents
+  // sibling covers the aperture; anything it does not yet cover (a brand-new tab momentarily at the wrong
+  // emulation scale, a mid-zoom frame) now shows the light desk instead of a black block. That is the fix
+  // for "part of the phone goes dark after zoom-in + new tab", and the thin stroke doubles as the hairline
+  // device border.
+  cc::PaintFlags border_flags;
+  border_flags.setColor(SkColorSetRGB(18, 23, 31));
+  border_flags.setStyle(cc::PaintFlags::kStroke_Style);
+  border_flags.setStrokeWidth(kFrameBorder);
+  border_flags.setAntiAlias(true);
+  gfx::RectF ring(geometry.frame);
+  ring.Inset(kFrameBorder / 2.0f);  // keep the stroke fully inside the frame rect
+  canvas->DrawRect(ring, border_flags);
+
+  // Vertical scrollbar in the reserved right-edge gutter, shown only when the
+  // zoomed device is taller than the stage (max_scroll_ set by CalculateGeometry
+  // just above). The WebContents aperture was clamped to leave this gutter clear.
+  const gfx::Rect track = ScrollTrackBounds();
+  if (!track.IsEmpty()) {
+    const float radius = kScrollbarThumbWidth / 2.0f;
+    cc::PaintFlags track_flags;
+    track_flags.setColor(SkColorSetARGB(38, 18, 23, 31));
+    track_flags.setAntiAlias(true);
+    canvas->DrawRoundRect(gfx::RectF(track), radius, track_flags);
+
+    cc::PaintFlags thumb_flags;
+    thumb_flags.setColor(SkColorSetARGB(150, 18, 23, 31));
+    thumb_flags.setAntiAlias(true);
+    canvas->DrawRoundRect(gfx::RectF(ScrollThumbBounds()), radius, thumb_flags);
+  }
+}
+
+gfx::Rect LobiumDeviceFrameView::ScrollTrackBounds() const {
+  if (max_scroll_ <= 0) {
+    return gfx::Rect();
+  }
+  gfx::Rect stage = GetLocalBounds();
+  stage.Inset(gfx::Insets(kStagePadding));
+  const int x =
+      stage.right() - kScrollbarGutter + (kScrollbarGutter - kScrollbarThumbWidth) / 2;
+  return gfx::Rect(x, stage.y(), kScrollbarThumbWidth, stage.height());
+}
+
+gfx::Rect LobiumDeviceFrameView::ScrollThumbBounds() const {
+  const gfx::Rect track = ScrollTrackBounds();
+  if (track.IsEmpty()) {
+    return gfx::Rect();
+  }
+  const int track_h = track.height();
+  // Thumb size is proportional to the visible fraction of the device. Computed in
+  // float to stay overflow-safe regardless of device/stage size.
+  const float visible_fraction =
+      static_cast<float>(track_h) / static_cast<float>(track_h + max_scroll_);
+  const int thumb_h =
+      std::max(kScrollbarMinThumb, static_cast<int>(track_h * visible_fraction));
+  const int travel = std::max(0, track_h - thumb_h);
+  const int scroll = std::clamp(scroll_offset_, 0, max_scroll_);
+  const int thumb_y =
+      track.y() + (max_scroll_ > 0 ? travel * scroll / max_scroll_ : 0);
+  return gfx::Rect(track.x(), thumb_y, track.width(), thumb_h);
+}
+
+void LobiumDeviceFrameView::ScrollToThumbCenterY(int local_y) {
+  const gfx::Rect track = ScrollTrackBounds();
+  if (track.IsEmpty()) {
+    return;
+  }
+  const int thumb_h = ScrollThumbBounds().height();
+  const int travel = track.height() - thumb_h;
+  if (travel <= 0) {
+    return;
+  }
+  const int desired_top =
+      std::clamp(local_y - thumb_h / 2, track.y(), track.y() + travel);
+  const int scroll = (desired_top - track.y()) * max_scroll_ / travel;
+  const int clamped = std::clamp(scroll, 0, max_scroll_);
+  if (clamped == scroll_offset_) {
+    return;
+  }
+  scroll_offset_ = clamped;
+  browser_view_->InvalidateLayout();
+  SchedulePaint();
+}
+
+bool LobiumDeviceFrameView::OnMousePressed(const ui::MouseEvent& event) {
+  // Refresh max_scroll_ for the current geometry, then only capture presses that
+  // land in the scrollbar gutter (so clicks elsewhere on the desk are ignored).
+  CalculateGeometry(GetLocalBounds());
+  if (max_scroll_ <= 0 || !event.IsOnlyLeftMouseButton()) {
+    return false;
+  }
+  const gfx::Rect track = ScrollTrackBounds();
+  gfx::Rect gutter(track.x() - 5, track.y(), track.width() + 10, track.height());
+  if (!gutter.Contains(event.location())) {
+    return false;
+  }
+  ScrollToThumbCenterY(event.location().y());
+  return true;
+}
+
+bool LobiumDeviceFrameView::OnMouseDragged(const ui::MouseEvent& event) {
+  CalculateGeometry(GetLocalBounds());
+  if (max_scroll_ <= 0) {
+    return false;
+  }
+  ScrollToThumbCenterY(event.location().y());
+  return true;
+}
+
+bool LobiumDeviceFrameView::OnMouseWheel(const ui::MouseWheelEvent& event) {
+  // Only reachable when the pointer is over the desk/gutter (the WebContents on
+  // top consumes wheel events over the phone screen, so the page still scrolls).
+  CalculateGeometry(GetLocalBounds());
+  if (max_scroll_ <= 0) {
+    return false;
+  }
+  const int delta = event.y_offset() != 0
+                        ? event.y_offset()
+                        : (event.x_offset() > 0 ? kScrollWheelStep
+                                                : -kScrollWheelStep);
+  const int clamped = std::clamp(scroll_offset_ - delta, 0, max_scroll_);
+  if (clamped != scroll_offset_) {
+    scroll_offset_ = clamped;
+    browser_view_->InvalidateLayout();
+    SchedulePaint();
+  }
+  return true;
+}
+
+BEGIN_METADATA(LobiumDeviceFrameView)
+END_METADATA
