+  // Lobium: profile-name chip immediately left of the omnibox. Populated from the
+  // --lobium-profile-name switch the launcher passes per profile; absent switch => no chip.
+  {
+    const std::string lobium_profile_name =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            "lobium-profile-name");
+    if (!lobium_profile_name.empty()) {
+      auto chip = std::make_unique<views::View>();
+      auto* chip_layout =
+          chip->SetLayoutManager(std::make_unique<views::FlexLayout>());
+      chip_layout->SetOrientation(views::LayoutOrientation::kHorizontal)
+          .SetMainAxisAlignment(views::LayoutAlignment::kCenter)
+          .SetCrossAxisAlignment(views::LayoutAlignment::kCenter)
+          .SetCollapseMargins(true);
+      chip->SetBackground(views::CreateRoundedRectBackground(
+          SkColorSetA(SK_ColorGRAY, 0x33), 12));
+      chip->SetBorder(views::CreateEmptyBorder(gfx::Insets::VH(2, 8)));
+      chip->SetProperty(views::kMarginsKey, gfx::Insets::VH(0, 4));
+
+      auto* dot = chip->AddChildView(std::make_unique<views::View>());
+      dot->SetPreferredSize(gfx::Size(12, 12));
+      dot->SetBackground(views::CreateRoundedRectBackground(
+          SkColorSetRGB(0xD7, 0x19, 0x20), 6));
+      dot->SetProperty(views::kMarginsKey, gfx::Insets::TLBR(0, 0, 0, 6));
+
+      auto* label = chip->AddChildView(
+          std::make_unique<views::Label>(base::UTF8ToUTF16(lobium_profile_name)));
+      label->SetElideBehavior(gfx::ELIDE_TAIL);
+      label->SetMaximumWidthSingleLine(180);
+
+      chip->SetProperty(
+          views::kFlexBehaviorKey,
+          views::FlexSpecification(views::MinimumFlexSizeRule::kScaleToZero,
+                                   views::MaximumFlexSizeRule::kPreferred));
+      lobium_profile_chip_ = AddChildView(std::move(chip));
+    }
+  }
+
   if (location_bar_view) {
     location_bar_view_ = AddChildView(std::move(location_bar_view));
     location_bar_ = location_bar_view_;
