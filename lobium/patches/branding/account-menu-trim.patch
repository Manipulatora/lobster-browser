 void ProfileMenuView::OnAccountSettingsButtonClicked() {
@@ -921,6 +928,22 @@ ProfileMenuView::GetIdentitySectionParams(const ProfileAttributesEntry& entry) {
       break;
   }
 
+  // Lobium: never show the browser-level "Sign in to Lobium" / "Continue as …"
+  // promo pill. Each Lobium profile is a standalone isolated identity, so the
+  // signed-out sign-in promo is noise. Clearing the button text makes the base
+  // class skip building the identity button entirely. The reauth button shown
+  // for a sign-in-pending/paused account is intentionally left intact.
+  {
+    const signin_util::SignedInState lobium_signed_in_state =
+        signin_util::GetSignedInState(identity_manager);
+    if (lobium_signed_in_state == signin_util::SignedInState::kSignedOut ||
+        lobium_signed_in_state ==
+            signin_util::SignedInState::kWebOnlySignedIn) {
+      params.button_text.clear();
+      params.subtitle.clear();
+    }
+  }
+
   // Sets the default action if needed - if a button text was explicitly set and
   // no prior action was set.
   if (!params.button_text.empty() && params.button_action.is_null()) {
@@ -1083,10 +1106,10 @@ void ProfileMenuView::MaybeBuildGoogleServicesSettingsButton() {
     return;
   }
 
