@@ -3584,9 +3586,21 @@ bool BrowserView::CanActivate() const {
 }
 
 std::u16string BrowserView::GetWindowTitle() const {
+  // Lobium: on a tabbed window the title names the PROFILE where stock Chromium repeats the product
+  // name. This is the only surface with room for the full name - the taskbar tooltip and the
+  // window-list entry both read it, while the icon holds two glyphs - so the profile name replaces
+  // the product suffix rather than being added after it, keeping the title one "page - owner" pair
+  // instead of naming the browser twice. App, popup and devtools windows are left alone: their
+  // suffix is their own app name and is load-bearing for accessibility.
+  const std::u16string lobium_profile_name =
+      browser_->is_type_normal() ? lobium::ProfileDisplayName() : std::u16string();
+  const bool include_app_name = lobium_profile_name.empty();
   std::u16string title =
       WindowMetadataController::From(browser_.get())
-          ->GetWindowTitleForCurrentTab(true /* include_app_name */);
+          ->GetWindowTitleForCurrentTab(include_app_name);
+  if (!lobium_profile_name.empty()) {
+    title = base::StrCat({title, u" - ", lobium_profile_name});
+  }
 #if BUILDFLAG(IS_MAC)
   bool any_tab_playing_audio = false;
   bool any_tab_playing_muted_audio = false;
@@ -3856,7 +3870,21 @@ bool BrowserView::ShouldShowWindowIcon() const {
 ui::ImageModel BrowserView::GetWindowAppIcon() {
   web_app::AppBrowserController* app_controller =
       web_app::AppBrowserController::From(browser());
-  return app_controller ? app_controller->GetWindowAppIcon() : GetWindowIcon();
+  if (app_controller) {
+    return app_controller->GetWindowAppIcon();
+  }
+  // Lobium: the LARGE window-icon slot. Widget::UpdateWindowIcon feeds it to WM_SETICON/ICON_BIG on
+  // Windows (the taskbar button) and to the second _NET_WM_ICON entry on Linux (what the window
+  // manager scales for its overview), so it wants a bigger rendering than the title-bar icon rather
+  // than the same one - see kProfileAppIconSizeDip.
+  if (browser_->is_type_normal()) {
+    const gfx::ImageSkia icon =
+        lobium::ProfileWindowIcon(lobium::kProfileAppIconSizeDip);
+    if (!icon.isNull()) {
+      return ui::ImageModel::FromImageSkia(icon);
+    }
+  }
+  return GetWindowIcon();
 }
 
 ui::ImageModel BrowserView::GetWindowIcon() {
@@ -3891,6 +3919,15 @@ ui::ImageModel BrowserView::GetWindowIcon() {
         WindowMetadataController::From(browser_.get())->GetCurrentPageIcon());
   }
 
+  // Lobium: the SMALL window-icon slot, where stock Chromium leaves a tabbed window with no icon of
+  // its own and the operating system falls back to the executable's - identical for every profile,
+  // which is exactly what a profile launcher must not look like. Null when the launcher supplied no
+  // mark, which restores that stock behaviour.
+  const gfx::ImageSkia icon = lobium::ProfileWindowIcon(lobium::kProfileWindowIconSizeDip);
+  if (!icon.isNull()) {
+    return ui::ImageModel::FromImageSkia(icon);
+  }
+
   return ui::ImageModel();
 }
 
diff --git a/chrome/browser/shell_integration_linux.cc b/chrome/browser/shell_integration_linux.cc
--- a/chrome/browser/shell_integration_linux.cc
+++ b/chrome/browser/shell_integration_linux.cc
@@ -426,6 +426,16 @@ base::FilePath GetChromeExePath() {
 std::string GetProgramClassName(const base::CommandLine& command_line,
                                 const std::string& desktop_file_name) {
   std::string class_name = GetDesktopBaseName(desktop_file_name);
+  // Lobium: every profile is launched with its own --user-data-dir, so the fallback below would put
+  // a raw filesystem path in WM_CLASS and gnome-shell's window switcher would label the window
+  // "Lobium (/home/.../profiles/<uuid>)". The profile NAME disambiguates exactly as well and is what
+  // the operator recognises. Read as the native value rather than as ASCII: a name outside ASCII
+  // would otherwise come back empty and fall through to the path this exists to replace.
+  const std::string lobium_profile_name =
+      command_line.GetSwitchValueNative("lobium-profile-name");
+  if (!lobium_profile_name.empty()) {
+    return class_name + " (" + lobium_profile_name + ")";
+  }
   std::string user_data_dir =
       command_line.GetSwitchValueNative(switches::kUserDataDir);
   // If the user launches with e.g. --user-data-dir=/tmp/my-user-data, set the
