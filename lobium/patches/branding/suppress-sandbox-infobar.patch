diff --git a/chrome/browser/ui/startup/bad_flags_prompt.cc b/chrome/browser/ui/startup/bad_flags_prompt.cc
index ec4de18dce..e7265032b4 100644
--- a/chrome/browser/ui/startup/bad_flags_prompt.cc
+++ b/chrome/browser/ui/startup/bad_flags_prompt.cc
@@ -262,6 +262,16 @@ void ShowBadFlagsInfoBarHelper(content::WebContents* web_contents,
 }  // namespace
 
 void ShowBadFlagsPrompt(content::WebContents* web_contents) {
+  // Lobium: our packaged, sandbox-restricted launch environment intentionally passes
+  // flags Chromium would warn about (e.g. --no-sandbox, and proxy/cert flags). Those
+  // "unsupported command-line flag" infobars are product noise and not web-observable,
+  // so never surface them in Lobium. The runtime switch check keeps the code below
+  // reachable for the compiler (no -Wunreachable-code) while always returning here,
+  // since Lobium never passes --lobium-show-bad-flags.
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "lobium-show-bad-flags")) {
+    return;
+  }
 // On Android, ShowBadFlagsPrompt doesn't show the warning notification
 // for flags which are not available in about:flags.
 #if !BUILDFLAG(IS_ANDROID)
