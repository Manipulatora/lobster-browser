+  // A real security warning ("Not secure" / "Dangerous") must always take precedence over the profile
+  // identity, so surface it whenever present.
+  const std::u16string secure_text = model->GetSecureDisplayText();
+  if (!secure_text.empty()) {
+    return secure_text;
+  }
+  // Lobium: on every other page (a normal secure https:// site, which otherwise shows no chip text) the
+  // leading chip carries the profile identity, so the omnibox always reads as "<profile>" - the same as
