 namespace location_bar {
 
+namespace {
+
+// Lobium: the per-profile identity shown in the leading location-bar chip, passed by the launcher via
+// --lobium-profile-name. Empty when no profile name was supplied (e.g. a plain dev run), in which case
+// the chip falls back to ordinary Chromium behavior. This is the single source of the chip text so the
+// profile name renders identically on internal (chrome://) and normal (https://) pages.
+std::u16string LobiumProfileName() {
+  const std::string name =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "lobium-profile-name");
+  return name.empty() ? std::u16string() : base::UTF8ToUTF16(name);
+}
+
+}  // namespace
