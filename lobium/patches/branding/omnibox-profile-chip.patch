+++ b/chrome/browser/ui/views/location_bar/location_icon_state_helper.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/ui/views/location_bar/location_icon_state_helper.h"
 
+#include "base/command_line.h"
+#include "base/strings/utf_string_conversions.h"
 #include "build/branding_buildflags.h"
 #include "chrome/browser/extensions/extension_ui_util.h"
 #include "chrome/grit/branded_strings.h"
@@ -39,6 +41,17 @@ std::u16string GetSecurityChipText(const LocationBarModel* model,
   if (model->GetURL().SchemeIs(content::kChromeUIScheme) ||
       (contextual_tasks::ShouldShowExpandedSecurityChip() &&
        model->IsContextualTasksPage())) {
+    // Lobium: on internal (chrome://) pages the leading chip carries the profile
+    // identity — the per-profile name passed via --lobium-profile-name — instead
+    // of the bare product name, so chrome://version etc. read as "<profile>" with
+    // the lobster glyph. Falls back to the product short name when the launcher
+    // supplied no profile name.
+    const std::string lobium_profile_name =
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            "lobium-profile-name");
+    if (!lobium_profile_name.empty()) {
+      return base::UTF8ToUTF16(lobium_profile_name);
+    }
     return l10n_util::GetStringUTF16(IDS_SHORT_PRODUCT_NAME);
   }
 
