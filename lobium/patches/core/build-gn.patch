+      # Lobium: chrome_main.cc answers --lobium-fingerprint-capabilities from this module. The symbol
+      # would also arrive transitively through //content, but the dependency is stated because the
+      # capability contract is a safety claim the sidecar gates launches on - it should not rest on
+      # an unrelated target happening to pull the module in.
+      "//components/lobium_fp",
       "//components/memory_system",
       "//components/policy:generated",
       "//components/webapps/isolated_web_apps:scheme",
