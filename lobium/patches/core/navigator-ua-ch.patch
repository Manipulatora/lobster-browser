 blink::UserAgentMetadata GetUserAgentMetadata(bool only_low_entropy_ch) {
+  // Lobium: build ALL Sec-CH-UA client hints from the persona config when present, so the low-entropy
+  // hints (Sec-CH-UA / -Mobile / -Platform, sent on EVERY request incl. workers) and the high-entropy
+  // hints agree with navigator.userAgent. Without this the header would announce the engine's real
+  // Chromium brand + Linux platform next to a persona UA - an obvious cross-check failure. Same config
+  // source as GetUserAgent() above; the persona brand list already includes "Google Chrome", so this
+  // also removes the unbranded-Chromium tell natively (no per-frame CDP override needed).
+  if (const lobium::LobiumFpConfig* cfg = lobium::LobiumFpConfig::Current();
+      cfg && !cfg->navigator.ua_brands.empty()) {
+    const auto& nav = cfg->navigator;
+    blink::UserAgentMetadata metadata;
+    for (const auto& bv : nav.ua_brands) {
+      metadata.brand_version_list.emplace_back(bv.first, bv.second);
+    }
+    metadata.mobile = nav.ua_mobile;
+    metadata.platform = nav.ua_platform;
+    if (only_low_entropy_ch) {
+      return metadata;
+    }
+    // High-entropy: real brands (version == UA major) carry the full build; the GREASE brand keeps its
+    // own version padded to a build shape - mirrors Chrome so getHighEntropyValues agrees with the UA.
+    const std::string major =
+        nav.ua_full_version.substr(0, nav.ua_full_version.find('.'));
+    for (const auto& bv : nav.ua_brands) {
+      const std::string full = (bv.second == major && !nav.ua_full_version.empty())
+                                   ? nav.ua_full_version
+                                   : bv.second + ".0.0.0";
+      metadata.brand_full_version_list.emplace_back(bv.first, full);
+    }
+    metadata.full_version = nav.ua_full_version;
+    metadata.platform_version = nav.ua_platform_version;
+    // Architecture/bitness/model/wow64 are driven by the PERSONA, not the host (FP-3): an Apple-Silicon
+    // Mac persona reports arm/64 even on an x86 build host, matching its WebGL "Apple M<n>" renderer and
+    // the CDP metadata (both compute Sec-CH-UA-Arch from the same persona arch). All catalog desktop
+    // personas are 64-bit with no device model and no WoW64.
+    //
+    // ANDROID IS DIFFERENT, and getting it wrong is a one-call unmask. Chromium's own
+    // GetCpuArchitecture()/GetCpuBitness() return "" on Android (see their definitions below), so every
+    // real Android Chrome answers getHighEntropyValues(['architecture','bitness']) with EMPTY STRINGS.
+    // A mobile persona reporting "arm"/"64" is a value no Android Chrome has ever sent. Key off the
+    // persona's own mobile bit rather than the build target, because this binary is a DESKTOP build
+    // emulating Android - BUILDFLAG(IS_ANDROID) is false here.
+    if (nav.ua_mobile) {
+      metadata.architecture = std::string();
+      metadata.bitness = std::string();
+    } else {
+      metadata.architecture =
+          cfg->arch.empty() ? GetCpuArchitecture() : (cfg->arch == "arm64" ? "arm" : "x86");
+      metadata.bitness = cfg->arch.empty() ? GetCpuBitness() : "64";
+    }
+    metadata.wow64 = false;
+    metadata.model = nav.ua_model;
+    // Sec-CH-UA-Form-Factors. The default derivation is a binary Mobile/Desktop split off the mobile
+    // bit, which mislabels a TABLET: an Android tablet sets uaMobile=false (real tablet Chrome omits
+    // the "Mobile" UA token), so the default would announce "Desktop" beside a tablet Sec-CH-UA-Model
+    // and an Android platform. The persona states its own form factor when it has one.
+    if (!nav.ua_form_factor.empty()) {
+      metadata.form_factors = {nav.ua_form_factor};
+    } else {
+      metadata.form_factors = GetFormFactorsClientHint(metadata, metadata.mobile);
+    }
+    return metadata;
+  }
+
   blink::UserAgentMetadata metadata;
 
   // Low entropy client hints.
diff --git a/third_party/blink/common/device_memory/approximated_device_memory.cc b/third_party/blink/common/device_memory/approximated_device_memory.cc
