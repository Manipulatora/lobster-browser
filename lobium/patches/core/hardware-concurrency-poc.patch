diff --git a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
index f5c0db2d1b..62ec72e13d 100644
--- a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
+++ b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
@@ -4,11 +4,57 @@
 
 #include "third_party/blink/renderer/core/frame/navigator_concurrent_hardware.h"
 
+#include <cstdlib>
+#include <optional>
+#include <string>
+
+#include "base/command_line.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
 #include "base/system/sys_info.h"
+#include "base/values.h"
 
 namespace blink {
 
+namespace {
+
+// Lobium native fingerprint override. Reads the configured hardwareConcurrency ONCE (cached), from
+// either the full config channel (`--lobium-fp-config=<lobium-fp.json>`, the production path written
+// by the sidecar's lobium-config.ts) or the single-value POC shortcut (`--lobium-hwc=<n>`). Returns
+// 0 when unconfigured. Because this resolves in C++ inside Blink, there is no JS-detectable tell —
+// the exact capability the interim CDP/JS engine cannot provide.
+int LobiumConfiguredHardwareConcurrency() {
+  static const int value = []() -> int {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (cmd->HasSwitch("lobium-fp-config")) {
+      std::string contents;
+      if (base::ReadFileToString(cmd->GetSwitchValuePath("lobium-fp-config"), &contents)) {
+        if (auto root = base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC); root) {
+          if (const auto* nav = root->FindDict("navigator")) {
+            if (auto hc = nav->FindInt("hardwareConcurrency"); hc && *hc > 0) {
+              return *hc;
+            }
+          }
+        }
+      }
+    }
+    if (cmd->HasSwitch("lobium-hwc")) {
+      const int n = std::atoi(cmd->GetSwitchValueASCII("lobium-hwc").c_str());
+      if (n > 0) {
+        return n;
+      }
+    }
+    return 0;
+  }();
+  return value;
+}
+
+}  // namespace
+
 unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
+  if (const int configured = LobiumConfiguredHardwareConcurrency(); configured > 0) {
+    return static_cast<unsigned>(configured);
+  }
   return static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
 }
 
