+  // Lobium: a per-profile config overrides the reported memory at this SINGLE source, so
+  // navigator.deviceMemory AND the Device-Memory / Sec-CH-Device-Memory client-hint headers — which
+  // all read this function — report the identical, coherent, spec-valid value.
+  if (const lobium::LobiumFpConfig* cfg = lobium::LobiumFpConfig::Current();
+      cfg && cfg->navigator.device_memory > 0) {
+    return LobiumRoundDeviceMemoryGb(cfg->navigator.device_memory);
+  }
