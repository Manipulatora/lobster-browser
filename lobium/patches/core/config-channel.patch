+#include "build/build_config.h"
+#include "components/lobium_fp/lobium_fp_config.h"
 #include "third_party/blink/public/common/features.h"
 
 namespace blink {
 
+namespace {
+
+// Lobium: round a configured deviceMemory (GB) exactly as CalculateAndSetApproximatedDeviceMemory does
+// for real RAM — nearest power-of-two GB, then clamp to this build's platform limits — so the value is
+// always one a genuine Chromium of this version could emit (no off-spec / out-of-range tell).
+float LobiumRoundDeviceMemoryGb(double configured_gb) {
+  int64_t mb = static_cast<int64_t>(configured_gb * 1024.0);
+  if (mb < 1) {
+    mb = 1;
+  }
+  int64_t lower = mb;
+  int power = 0;
+  while (lower > 1) {
+    lower >>= 1;
+    power++;
+  }
+  const int64_t upper = (lower + 1) << power;
+  lower = lower << power;
+  float gb = (mb - lower <= upper - mb) ? static_cast<float>(lower) / 1024.0f
+                                        : static_cast<float>(upper) / 1024.0f;
+  float min_memory = 2.0f;
+  float max_memory = 32.0f;
+#if BUILDFLAG(IS_ANDROID)
+  min_memory = 1.0f;
+  max_memory = 8.0f;
+#endif
+  if (gb < min_memory) {
+    gb = min_memory;
+  } else if (gb > max_memory) {
+    gb = max_memory;
+  }
+  return gb;
+}
+
+}  // namespace
+
