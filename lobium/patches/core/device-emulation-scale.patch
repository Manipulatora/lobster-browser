new file mode 100644
--- /dev/null
+++ b/content/public/browser/lobium_device_emulation.h
@@ -0,0 +1,21 @@
+// Copyright 2026 The Lobster Browser Authors.
+
+#ifndef CONTENT_PUBLIC_BROWSER_LOBIUM_DEVICE_EMULATION_H_
+#define CONTENT_PUBLIC_BROWSER_LOBIUM_DEVICE_EMULATION_H_
+
+#include "content/common/content_export.h"
+
+namespace content {
+
+class WebContents;
+
+// Updates only the compositor scale of an already enabled device-metrics
+// emulation session. The emulated screen/view dimensions and device scale
+// factor are intentionally left unchanged. Returns true when at least one
+// attached DevTools emulation session was updated.
+CONTENT_EXPORT bool SetLobiumDeviceEmulationScale(WebContents* web_contents,
+                                                  float scale);
+
+}  // namespace content
+
+#endif  // CONTENT_PUBLIC_BROWSER_LOBIUM_DEVICE_EMULATION_H_
