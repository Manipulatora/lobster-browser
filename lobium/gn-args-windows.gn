# Shipping GN build args for Lobium on WINDOWS (x64).
#
# DESIGN PRINCIPLE: match Google's official Chrome-for-Windows build configuration as closely as a
# non-Google build can. This is an anti-detect engine, so the build config itself is part of the
# fingerprint: DCHECK builds, component builds, missing PGO and disabled codecs all change timing
# signatures, feature availability, chrome://gpu contents and error-message shapes in ways that
# differ from the Chrome a persona claims to be. "Faster to build" is never a reason to deviate.
#
# Used by lobium/build.ps1. The Linux counterpart is gn-args.gn.example.

# ---- Release configuration -------------------------------------------------------------------
# Chromium's BUILDCONFIG is explicit that `is_debug = false` alone is NOT an end-user build:
# DCHECKs and the component layout materially reduce performance. is_official_build turns on the
# full optimisation set (whole-program opt, /OPT:ICF, no dev-only instrumentation).
is_debug = false
is_official_build = true
is_component_build = false
dcheck_always_on = false
target_cpu = "x64"

# ---- Runtime speed ---------------------------------------------------------------------------
# PGO is the single largest runtime win on Chromium (~10% on real page loads) and is what stock
# Chrome ships with. phase 2 = "use the downloaded profile". The profile must be present in
# chrome/build/pgo_profiles/ - fetched by tools/update_pgo_profiles.py --target=win64, which only
# runs as a gclient hook when .gclient sets custom_vars = { "checkout_pgo_profiles": True }.
# Without the profile, gn gen FAILS rather than silently producing a slower binary.
chrome_pgo_phase = 2

# ThinLTO is also what stock Chrome ships. It costs a long link but is worth several percent at
# runtime and, more importantly, keeps codegen equivalent to real Chrome.
use_thin_lto = true

# ---- Media ------------------------------------------------------------------------------------
# Without these, HTMLMediaElement.canPlayType() and MediaRecorder.isTypeSupported() report no
# H.264/AAC - an immediate Chromium-not-Chrome tell, and broken video on most of the web.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# ---- Binary size / build time (does not change runtime behaviour) ------------------------------
# Stock Chrome ships stripped binaries with separate PDBs. We drop debug info entirely: it saves
# roughly 40 GB of intermediates and hours of link time on this 8-core host, and the shipped
# runtime is byte-for-byte equivalent in behaviour.
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

# ---- Build throughput (does not alter the produced runtime) -------------------------------------
# No RBE credentials on this host, so everything is local. Left explicit rather than defaulted so
# a stray environment variable cannot silently enable a remote backend for a private build.
use_remoteexec = false

# Link concurrency is DELIBERATELY NOT SET HERE, and must not be reintroduced.
#
# `concurrent_links = 1` used to live on this line. It is illegal in this configuration:
# //build/toolchain/concurrent_links.gni asserts
#     assert(!use_thin_lto, "can't explicitly set concurrent_links with thinlto")
# so with `use_thin_lto = true` above, setting it fails `gn gen` outright rather than saving any
# memory. Measured on 152.0.7977.42.
#
# It was also unnecessary. Chromium already derives the value from the host when the arg is left at
# its -1 default: for a ThinLTO build it passes --reserve_mem_gb=10 with --mem_per_link_gb=45 on
# Windows (30 on Linux), which is exactly the "don't overlap two huge links on a small box"
# reasoning this line was written for — with the real per-platform numbers rather than a guess.
# A 16 GB host therefore already gets one link at a time without being told.

# ---- EME / Widevine ----
# Every persona claims the "Google Chrome" brand in Sec-CH-UA, and every real Chrome resolves
# navigator.requestMediaKeySystemAccess('com.widevine.alpha'). A Chromium build defaults
# enable_widevine to false (widevine.gni gates it on is_chrome_branded), so without this the key
# system is not even registered and one call unmasks every profile. Measured on the 24-persona
# conformance fleet: chrome-without-widevine fired 24/24.
#
# The CDM is NOT bundled. bundle_widevine_cdm would require shipping Google's binary, and
# third_party/widevine/LICENSE is explicit: "You may not use, modify, sell, or otherwise distribute
# the Software without a separate license agreement with Google." Leaving it unset makes
# enable_widevine_cdm_component true instead, so the CDM is fetched by Chromium's own component
# updater from Google, to the user's machine, exactly as it is for every other Chromium-derived
# browser. perf/skip-heavy-components.patch suppresses only SODA/TranslateKit/WasmTts, so this
# component still registers.
enable_widevine = true
