{
  "name": "lobster-browser",
  "version": "0.0.0",
  "private": true,
  "description": "Lobster Browser — anti-detect browser + SaaS (monorepo root)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12 <25"
  },
  "workspaces": [
    "packages/shared-types",
    "packages/crypto",
    "packages/fingerprint",
    "packages/proxy",
    "packages/cookies",
    "packages/agent",
    "packages/engine-runner",
    "packages/lobee-app",
    "packages/local-api-sdk/js",
    "apps/desktop",
    "apps/backend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "generate:fingerprint-catalog": "node scripts/generate-fingerprint-catalog.mjs",
    "venice:chat": "node --env-file=.env scripts/venice-chat.mjs",
    "apply:lobium-branding": "node scripts/apply-lobium-branding.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json}\"",
    "typecheck:core": "tsc -b packages/shared-types packages/crypto packages/fingerprint packages/proxy",
    "gate:engine": "node --test ci/validation/patch-series.test.mjs ci/validation/version-coherence.test.mjs ci/validation/source-hygiene.test.mjs ci/validation/canonical-seed.test.mjs ci/validation/windows-packager-contract.test.mjs ci/validation/windows-font-isolation-contract.test.mjs ci/validation/product-e2e-platform.test.mjs ci/validation/font-provisioner-contract.test.mjs ci/validation/native-probe-results.test.mjs ci/validation/engine-archive-gate.test.mjs",
    "gate:series": "node lobium/verify-series.mjs",
    "gate:kernels": "powershell -NoProfile -ExecutionPolicy Bypass -File lobium/test/run.ps1",
    "gate:desktop-css": "node ci/validation/desktop-css-contract.mjs",
    "gate:tls-proxy": "node ci/validation/tls-through-proxy.mjs",
    "gate:engine-archive": "node ci/validation/engine-archive-gate.mjs",
    "gate:migrations": "node ci/validation/migration-gate.mjs",
    "gate:oracles": "node ci/validation/audit-oracles.mjs",
    "gate:fonts": "node ci/validation/font-isolation-gate.mjs",
    "gate:font-pack": "node ci/validation/font-pack-registration-gate.mjs",
    "gate:webgl": "node ci/validation/webgl-availability-gate.mjs",
    "gate:webrtc": "node ci/validation/webrtc-leak-gate.mjs",
    "gate:conformance": "node ci/validation/fingerprint-conformance.mjs",
    "e2e:desktop": "playwright test --config ci/playwright.desktop.config.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.9.0",
    "openai": "^6.47.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
